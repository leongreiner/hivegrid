def gui_pid():
    try:
        return int(open(os.path.join(S, "wezterm.pid")).read())
    except (OSError, ValueError):
        return 0


def alive(pid):
    try:
        os.kill(pid, 0)
    except OSError:
        return False
    try:  # a zombie is gone for our purpose
        return open(f"/proc/{pid}/stat").read().rsplit(")", 1)[1].split()[0] != "Z"
    except OSError:
        return False


def section_restart():
    print("-- 8 the GUI restarts, the server follows")
    # Only the GUI: `hgq restart` would kill the server too (down kills everything with the sandbox HOME).
    pid = gui_pid()
    socks = lambda: [f for f in os.listdir(os.path.join(S, "run", "wezterm")) if f.startswith("gui-sock-")] \
        if os.path.isdir(os.path.join(S, "run", "wezterm")) else []
    old = set(socks())
    if not check("8 the GUI pid is known", pid > 0):
        return
    os.kill(pid, 15)
    gone = waitfor(lambda: not alive(pid), 15)
    check("8 the GUI exited", bool(gone))
    saw503 = bool(waitfor(lambda: (lambda r: isinstance(r[1], dict) and r[1].get("error") == "no_mux" and r[0] == 503)(api("GET", "/api/agents")), 15, 0.3))
    check("8 503 no_mux while the GUI is down", saw503)
    print(f"     stale gui-sock files left by the old GUI: {sorted(old & set(socks())) or 'none'}")
    hgq("up", SLOT, 1280, 720, timeout=120)
    back = waitfor(lambda: api("GET", "/api/agents")[0] == 200, 40, 0.5)
    check("8 200 again after the restart (the server found the new socket)", bool(back), str(api("GET", "/api/agents")))
    check("8 the same server process kept running", server is not None and server.poll() is None)


def bapi(method, path, body=None, **kw):
    """`api`, waiting out the server's own rate limits (a burst of writes is exactly what this section makes)."""
    for _ in range(6):
        st, doc = api(method, path, body, **kw)
        if st != 429:
            break
        time.sleep(2.2)
    return st, doc


def bot_fixtures():
    """Three bots with runs in the sandbox's own schedule store (never the real one): a task with an unread result and a report, an
    agent with memory whose last run failed, and a task that is running now."""
    import hivegrid_schedule as sch
    env = BOT_ENV
    cfg = sch.config_dir(env)
    if os.path.isdir(cfg):
        os.chmod(cfg, 0o700)       # the sandbox's own config dir is made group-writable; hivegrid_schedule refuses such a directory
    store = sch.Store(env=env)
    for rec in store.read():
        store.remove(rec["id"])
    now = int(time.time())
    made = {}
    for name, kind, run in (("digest", "task", {}), ("watcher", "agent", {}), ("slow job", "task", {})):
        rec = store.add({"name": name, "kind": kind, "when": {"type": "cron", "expr": "0 9 * * 1-5", "tz": "local"},
                         "task": {"prompt": f"Fixture task of {name}"}, "run": dict({"cwd": HOME}, **run)}, now=now, origin="cli")
        sch.init_state_dir(rec, now, env)
        made[name] = rec
    d = sch.state_dir(made["digest"]["id"], env)
    sch.append_run(d, {"run": 1, "schedule": made["digest"]["id"], "trigger": "cron", "status": "ok", "started": now - 400, "ended": now - 300,
                       "summary": "Summarized **12** mails.", "cost_usd": 0.12, "level": "important", "headline": "12 mails summarized, 2 need an answer"})
    with open(sch.report_path(made["digest"]["id"], 1, env), "w") as f:
        f.write("# Digest\n\n- mail one\n- mail two\n")
    w = sch.state_dir(made["watcher"]["id"], env)
    sch.append_run(w, {"run": 1, "schedule": made["watcher"]["id"], "trigger": "cron", "status": "failed", "started": now - 900, "ended": now - 800,
                       "error": "omp exited with status 1", "summary": "build is red", "level": "important", "headline": "watcher failed: omp exited with status 1"})
    sch.append_run(w, {"run": 2, "schedule": made["watcher"]["id"], "trigger": "cron", "status": "ok", "started": now - 200, "ended": now - 100,
                       "summary": "CI green, nothing to do", "level": "none", "headline": "CI green, nothing to do", "seen": True})
    sess = os.path.join(HOME, ".omp", "agent", "sessions", "-fixture-")
    os.makedirs(sess, exist_ok=True)
    main_session = os.path.join(sess, "2026-11-02T08-00-00-000Z_aaaaaaaaaaaaaaaa.jsonl")
    with open(main_session, "w") as f:
        f.write(json.dumps({"type": "session", "version": 3, "id": "aaaaaaaaaaaaaaaa", "timestamp": "2026-11-02T08:00:00.000Z", "cwd": HOME}) + "\n")
        f.write(json.dumps({"type": "message", "id": "m1", "parentId": None, "timestamp": "2026-11-02T08:00:01.000Z",
                            "message": {"role": "user", "content": [{"type": "text", "text": "is the build green?"}]}}) + "\n")
        f.write(json.dumps({"type": "message", "id": "m2", "parentId": "m1", "timestamp": "2026-11-02T08:00:02.000Z",
                            "message": {"role": "assistant", "content": [{"type": "text", "text": "Yes: the fixture build is green."}]}}) + "\n")
    sch.update_state(w, lambda st: st.update(session_file=main_session))
    with open(sch.memory_path(made["watcher"]["id"], env), "w") as f:
        f.write("- build was red on Tuesday\n")
    sch.update_state(sch.state_dir(made["slow job"]["id"], env), lambda st: st.update(running={"run": 1, "pid": os.getpid(), "started": now - 30}))
    return made


def section_bots():
    print("-- 10 Bots")
    import hivegrid_schedule as sch
    made = bot_fixtures()
    ids = {k: v["id"] for k, v in made.items()}
