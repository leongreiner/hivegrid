    check("10 briefing: counts, the read one is seen", st == 200 and brief["total"] == 2 and brief["unseen"] == 1, str({k: brief.get(k) for k in ("total", "unseen")}))
    check("10 briefing: marking all seen clears the count", bapi("POST", "/api/bots/briefing/seen", {})[0] == 200 and bapi("GET", "/api/bots/briefing")[1]["unseen"] == 0)
    st, conv = bapi("GET", f"/api/bots/{ids['watcher']}/conversation")
    check("10 conversation: the bot's session file as chat items", st == 200 and "the fixture build is green" in json.dumps(conv["items"]) and conv["session"] is True, str(conv)[:300])
    check("10 conversation: the path never leaves the server", HOME not in json.dumps(conv))
    st, say = bapi("POST", f"/api/bots/{ids['watcher']}/say", {"text": "hello"})
    check("10 say without a scheduler: 409 with a clear message", st == 409 and "scheduler is not running" in say.get("message", ""), f"{st} {say}")
    check("10 say: text bounded at 4000", bapi("POST", f"/api/bots/{ids['watcher']}/say", {"text": "x" * 4001})[0] == 400)

    st, parsed = bapi("POST", "/api/bots/parse", {"text": "weekdays 9am"})
    check("10 parse: weekdays 09:00 with three next times", st == 200 and parsed["describe"] == "weekdays 09:00" and len(parsed["next"]) == 3, str(parsed))
    check("10 parse: a repeat under five minutes is an error text", bapi("POST", "/api/bots/parse", {"text": "every 2m"})[1]["error"] is not None)

    body = {"name": "from phone", "prompt": "Reply with pong", "when": "daily 8am", "dir": "~", "max_time_s": 600, "max_cost_usd": 0.5}
    for what, extra in (("full permissions", {"permissions": "full"}), ("an unknown field", {"origin": "cli"}), ("a cost above the cap", {"max_cost_usd": 99}),
                        ("a path outside the home", {"dir": "/etc"}), ("a repeat under five minutes", {"when": "every 1m"})):
        st, doc = bapi("POST", "/api/bots", dict(body, **extra))
        check(f"10 create with {what}: 400", st == 400, f"{st} {doc}")
    no_cap = dict(body)
    del no_cap["max_cost_usd"]
    check("10 create without a cost cap: 400", bapi("POST", "/api/bots", no_cap)[0] == 400)
    st, created = bapi("POST", "/api/bots", dict(body, permissions="readonly"))
    check("10 a valid bot is created", st == 200 and created["ok"], f"{st} {created}")
    rec = sch.Store(env=BOT_ENV).get(created.get("id", "x"))
    check("10 ... as origin phone, read only, with its caps", bool(rec) and (rec["origin"], rec["run"]["permissions"], rec["run"]["max_time_s"], rec["run"]["max_cost_usd"]) == ("phone", "readonly", 600, 0.5), str(rec)[:300])
    check("10 ... and `hivegrid-schedule` agrees (the store validates it again)", bool(rec) and sch.validate(rec)["id"] == rec["id"])
    st, _ = bapi("POST", f"/api/bots/{created['id']}", {"permissions": "full"})
    check("10 a phone cannot raise a bot to full", st == 400)
    st, _ = bapi("POST", f"/api/bots/{created['id']}", {"name": "renamed", "max_cost_usd": 1})
    check("10 an edit changes the name and the cap", st == 200 and sch.Store(env=BOT_ENV).get(created["id"])["name"] == "renamed")

    st, r = bapi("POST", f"/api/bots/{ids['digest']}/run", {})
    check("10 run now without a scheduler waits in the state file", st == 200 and r["queued"] and sch.load_state(sch.state_dir(ids["digest"], BOT_ENV))["run_now"])
    sch.write_summary(sch.summary_path(BOT_ENV), {"ts": int(time.time()), "scheduler": {"heartbeat": time.time()}, "counts": {}, "items": []})
    st, doc = bapi("GET", "/api/bots")
    check("10 a fresh heartbeat reads as a live scheduler", st == 200 and doc["scheduler"]["alive"] is True)
    st, say = bapi("POST", f"/api/bots/{ids['watcher']}/say", {"text": "any news?"})
    cmds = sch.read_commands(sch.command_dir(BOT_ENV)) if os.path.isdir(sch.command_dir(BOT_ENV)) else []
    check("10 say with a live scheduler: a chat command in the inbox and {queued, position}", st == 200 and "queued" in say and "position" in say and
          any(c.get("op") == "chat" and c.get("id") == ids["watcher"] and c.get("text") == "any news?" for c in cmds), f"{st} {say} {cmds}")
    st_skip = bapi("POST", f"/api/bots/{ids['watcher']}/skip", {})
    cmds = sch.read_commands(sch.command_dir(BOT_ENV)) if os.path.isdir(sch.command_dir(BOT_ENV)) else []
    check("10 skip goes to the live scheduler as a command", {"op": "skip", "id": ids["watcher"]} in cmds, f"{st_skip} {cmds}")
    st, _ = bapi("POST", f"/api/bots/{ids['watcher']}/pause", {})
    check("10 pause disables, resume enables again", st == 200 and not sch.Store(env=BOT_ENV).get(ids["watcher"])["enabled"] and bapi("POST", f"/api/bots/{ids['watcher']}/resume", {})[0] == 200 and sch.Store(env=BOT_ENV).get(ids["watcher"])["enabled"])
    check("10 delete needs confirm", bapi("POST", f"/api/bots/{created['id']}/delete", {})[0] == 409)
    st, _ = bapi("POST", f"/api/bots/{created['id']}/delete", {"confirm": True})
    check("10 delete with confirm removes the bot and its state", st == 200 and sch.Store(env=BOT_ENV).get(created["id"]) is None and not os.path.exists(sch.state_dir(created["id"], BOT_ENV)))
    check("10 no auth: 401", req("GET", "/api/bots")[0] == 401 and req("POST", "/api/bots/parse", {"text": "daily"})[0] == 401)
    check("10 another site's Origin: 403", bapi("POST", "/api/bots/parse", {"text": "daily"}, headers={"Origin": "http://evil.example"})[0] == 403)

    chrome = chrome_path()
    if chrome:
        with tempfile.TemporaryDirectory() as prof:
            r = subprocess.run([chrome, "--headless=new", "--no-sandbox", "--disable-gpu", f"--user-data-dir={prof}", "--timeout=4000", "--dump-dom",
                                f"http://127.0.0.1:{PORT}/#t={TOKEN}"], capture_output=True, text=True, timeout=60)
        check("10 the page has a Bots button with the clock glyph", 'aria-label="Bots' in r.stdout and "\u25f7" in r.stdout, r.stdout[:200])
    else:
        print("skip no Chromium-family browser found for the page check")

    BOT_IDS.update(ids)
    BOT_IDS["_body"] = body


def bots_readonly():
    """10, the last part: a `--read-only` server (already started) refuses every write of the Bots and still lists them."""
    if "digest" not in BOT_IDS:
        return
    for verb, b in (("run", {}), ("skip", {}), ("pause", {}), ("resume", {}), ("cancel", {}), ("ack", {}), ("delete", {"confirm": True})):
        st, _ = bapi("POST", f"/api/bots/{BOT_IDS['digest']}/{verb}", b)
        check(f"10 read-only: {verb} is 403", st == 403, str(st))
    check("10 read-only: create is 403", bapi("POST", "/api/bots", BOT_IDS["_body"])[0] == 403)
    check("10 read-only: say and briefing/seen are 403", bapi("POST", f"/api/bots/{BOT_IDS['digest']}/say", {"text": "hi"})[0] == 403 and bapi("POST", "/api/bots/briefing/seen", {})[0] == 403)
    check("10 read-only: the briefing and the conversation can be read", bapi("GET", "/api/bots/briefing")[0] == 200 and bapi("GET", f"/api/bots/{BOT_IDS['watcher']}/conversation")[0] == 200)
    check("10 read-only: the list still works", bapi("GET", "/api/bots")[0] == 200)


def start_standalone():
    """--bots: the real server in a throwaway HOME and runtime dir, bound to a loopback port, with no window to find."""
    import shutil
    global server, TOKEN, HOME, BOT_ENV, S, STANDALONE
    tmp = tempfile.mkdtemp(prefix="hg-bots-smoke-")
    HOME = os.path.join(tmp, "home")
    run = os.path.join(tmp, "run")
    os.makedirs(HOME)
    os.makedirs(run, mode=0o700)
    S = tmp
    BOT_ENV = {"HOME": HOME, "XDG_RUNTIME_DIR": run}
    env = {"PATH": os.environ.get("PATH", "/usr/bin:/bin"), "HOME": HOME, "XDG_RUNTIME_DIR": run, "LANG": "C.UTF-8"}
    tfile = os.path.join(tmp, "token")
    subprocess.run([sys.executable, os.path.join(ROOT, "bin", "hivegrid-remote"), "token", "--token-file", tfile], env=env, capture_output=True, text=True, timeout=30)
    TOKEN = open(tfile).read().strip()
    STANDALONE = ([sys.executable, os.path.join(ROOT, "bin", "hivegrid-remote"), "serve", "--port", str(PORT), "--token-file", tfile], env)
    return tmp if start_server() else None


def section_readonly():
    print("-- 9 read-only")
    if not start_server("--read-only"):
        check("9 the read-only server starts", False)
        return
    posts = [("prompt", {"text": "x"}), ("keys", {"keys": ["enter"]}), ("plan", {"choice": "execute"}), ("ack", {})]
    for name, body in posts:
        st, _ = api("POST", f"/api/agents/1/{name}", body)
        check(f"9 POST {name}: 403", st == 403, str(st))
    check("9 GET still works", api("GET", "/api/agents")[0] in (200, 503))
    time.sleep(6)       # the write bucket refills
    bots_readonly()


def main_bots():
    tmp = start_standalone()
    try:
        if not tmp:
            check("the server starts", False)
        else:
            section_bots()
            if start_server("--read-only"):
                bots_readonly()
    except Exception as e:
        check("the run finished without an error", False, repr(e))
    finally:
        stop_server()
        if tmp and not KEEP:
            import shutil
            shutil.rmtree(tmp, ignore_errors=True)
    if fails:
        print(f"remote-smoke --bots: {len(fails)} failed")
        return 1
    print("remote-smoke --bots passed")
    return 0


def main():
    global BOT_ENV
    if BOTS_ONLY:
        return main_bots()
    hgq("down", SLOT, check=False)
    hgq("up", SLOT, 1280, 720)
    try:
        time.sleep(2)
        install_fake_omp()
        hgq("sh", SLOT, "omp-grid", 1, 3, "--tab")
