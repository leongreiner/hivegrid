#!/usr/bin/env python3
"""Hivegrid git view: lists every git repository of the working directory and opens lazygit in one.

Usage: hivegrid-git [DIR]

Scans DIR (default: the current directory) the way VS Code's Source Control view does: the
repository around it plus the repositories below it, up to HIVEGRID_GIT_DEPTH levels (default 3).
With one repository (or none) it starts lazygit there at once. With several it shows an overview
(branch, commits ahead/behind, staged/changed/untracked files, CI result, refreshed every few
seconds); Enter or a click opens lazygit in the selected repository and quitting lazygit returns
to the overview. A repository with GitHub Actions workflows shows "CI ✓/✗/◔" for the latest runs
on its checked-out branch (read through the gh CLI every minute; ? when gh cannot tell).

Keys: Up/Down or k/j move, Enter/Right/l or a click open, r rescans, q/Esc closes.
Environment: HIVEGRID_GIT_DEPTH scan depth; HIVEGRID_LAZYGIT path of the lazygit binary.
"""
import os
import select
import shutil
import signal
import subprocess
import sys
import termios
import threading
import time
import tty
from concurrent.futures import ThreadPoolExecutor

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import hivegrid_repos as R  # noqa: E402

REFRESH_EVERY = 5.0
CI_REFRESH_EVERY = 60.0  # CI results come over the network
WORKERS = 4
ROW_H = 2
# CI state -> (glyph, palette key). Repositories without workflows have no state and show nothing.
CI_MARKS = {"pass": ("✓", "green"), "fail": ("✗", "red"), "running": ("◔", "amber"),
            "other": ("–", "muted"), "none": ("–", "muted"), "unknown": ("?", "muted")}


def lazygit_path():
    for cand in (os.environ.get("HIVEGRID_LAZYGIT"), os.path.expanduser("~/.local/bin/lazygit")):
        if cand and os.access(cand, os.X_OK):
            return cand
    return shutil.which("lazygit")


def exec_lazygit(lazygit, path):
    os.chdir(path)
    os.environ["PWD"] = path
    os.execv(lazygit, [lazygit])


class Refresher:
    """Runs `fn` over all repositories on a background thread every `every` seconds; the UI polls
    `take()` and `due()`."""

    def __init__(self, fn, every):
        self.fn, self.every = fn, every
        self.busy = False
        self.done_at = 0.0
        self.fresh = False

    def kick(self, repos):
        if self.busy:
            return
        self.busy = True
        threading.Thread(target=self._run, args=(list(repos),), daemon=True).start()

    def _run(self, repos):
        try:
            with ThreadPoolExecutor(WORKERS) as ex:
                list(ex.map(self.fn, repos))
        finally:
            self.done_at = time.monotonic()
            self.fresh = True
            self.busy = False

    def take(self):
        fresh, self.fresh = self.fresh, False
        return fresh

    def due(self):
        return not self.busy and time.monotonic() - self.done_at >= self.every


class View:
    def __init__(self, root, depth, lazygit):
        self.root, self.depth, self.lazygit, self.pal = root, depth, lazygit, None
        self.fd = sys.stdin.fileno()
        self.out = sys.stdout
        self.repos, self.truncated = [], False
        self.sel, self.top = 0, 0
        self.cv = None
        self.dirty = True
        self.running = True
        self.size = (0, 0)
        self.refresher = Refresher(R.status, REFRESH_EVERY)
        self.ci_refresher = Refresher(R.ci, CI_REFRESH_EVERY)
        self.old_tty = None

    # data -------------------------------------------------------------------
    def scan(self):
        keep = self.repos[self.sel].path if self.repos else None
        old = {r.path: (r.status, r.ci) for r in self.repos}
        self.repos, self.truncated = R.find_repos(self.root, self.depth)
        for r in self.repos:
            r.status, r.ci = old.get(r.path, (None, None))
        paths = [r.path for r in self.repos]
        if keep in paths:
            self.sel = paths.index(keep)
        else:
            around = [i for i, p in enumerate(paths) if self.root == p or self.root.startswith(p + os.sep)]
            self.sel = max(around, key=lambda i: len(paths[i])) if around else 0
        self.dirty = True

    # terminal ---------------------------------------------------------------
    def enter(self):
        self.old_tty = termios.tcgetattr(self.fd)
        tty.setraw(self.fd)
        self.out.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1002h\x1b[?1006h")
        self.out.flush()
        self.dirty = True

    def leave(self):
        self.out.write("\x1b[?1006l\x1b[?1002l\x1b[?1000l\x1b[?25h\x1b[?1049l")
        self.out.flush()
        if self.old_tty:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, self.old_tty)

    def open_repo(self, repo):
        self.leave()
        # A handler (not SIG_IGN) keeps Ctrl+C from killing this process while lazygit runs; exec
        # resets handlers, so lazygit and its children still see the default action.
        signal.signal(signal.SIGINT, lambda *_: None)
        try:
            subprocess.run([self.lazygit], cwd=repo.path, env=dict(os.environ, PWD=repo.path))
        finally:
            signal.signal(signal.SIGINT, signal.default_int_handler)
            self.enter()
        self.refresher.done_at = self.ci_refresher.done_at = 0.0  # refresh now: lazygit probably changed things

    # drawing ----------------------------------------------------------------
    def draw(self):
        import hivegrid_ui as U

        cols, rows = self.size
        p = self.pal
        cv = U.Canvas(cols, rows, p["text"], p["base"])
        cv.fill(0, 0, cols, 1, bg=p["deep"])
        title = f"⬡ Git · {len(self.repos)} repositories"
        cv.put(1, 0, title[:cols - 2], p["accent"], p["deep"], U.BOLD)
        cv.fill(0, 1, cols, 1, bg=p["base"], fg=p["border"], ch="─")
        visible = max(1, (rows - 3) // ROW_H)
        self.top = min(max(self.top, self.sel - visible + 1), self.sel)
        self.top = max(0, min(self.top, len(self.repos) - visible))
        for slot, i in enumerate(range(self.top, min(len(self.repos), self.top + visible))):
            self.draw_row(cv, U, 2 + slot * ROW_H, cols, i)
        if self.truncated:
            cv.put(1, rows - 2, "scan stopped early; lower depth or cd deeper"[:cols - 2], p["amber"], p["base"])
        hints = "↵ open  r rescan  q close"
        cv.put(1, rows - 1, hints[:cols - 2], p["muted"], p["base"], U.DIM)
        self.cv = cv
        self.out.write("\x1b[?25l" + cv.render())
        self.out.flush()
        self.dirty = False

    def draw_row(self, cv, U, y, w, i):
        p, repo = self.pal, self.repos[i]
        st = repo.status
        sel = i == self.sel
        bg = p["raised"] if sel else p["base"]
        cv.fill(0, y, w, ROW_H, bg=bg)
        cv.hit(0, y, w, ROW_H, lambda b, i=i: self.click(i, b))
        if st is None:
            dot, dot_color = "…", p["muted"]
        elif st.get("error"):
            dot, dot_color = "✕", p["red"]
        elif st["conflicts"]:
            dot, dot_color = "●", p["red"]
        elif st["staged"] or st["changed"] or st["untracked"]:
            dot, dot_color = "●", p["amber"]
        else:
            dot, dot_color = "●", p["green"]
        cv.put(1, y, dot, dot_color, bg)

        sync = ""
        if st and not st.get("error") and st["ahead"] is not None:
            sync = " ".join(t for t in (f"↑{st['ahead']}" if st["ahead"] else "",
                                        f"↓{st['behind']}" if st["behind"] else "") if t)
        mark = CI_MARKS.get(repo.ci)
        left = w - 1
        if sync:
            left -= len(sync)
            cv.put(left, y, sync, p["cyan"], bg)
        if mark:
            left -= 4 + (1 if sync else 0)
            cv.put(left, y, "CI ", p["muted"], bg)
            cv.put(left + 3, y, mark[0], p[mark[1]], bg)
        name_w = left - 4 if sync or mark else w - 4
        cv.put(3, y, fit(repo.name, name_w), p["bright"] if sel else p["text"], bg, U.BOLD)

        if st is None:
            cv.put(3, y + 1, "reading…", p["muted"], bg)
        elif st.get("error"):
            cv.put(3, y + 1, "unreadable", p["red"], bg)
        else:
            counts = [(f"+{st['staged']}", p["green"], st["staged"]), (f"~{st['changed']}", p["amber"], st["changed"]),
                      (f"?{st['untracked']}", p["muted"], st["untracked"]), (f"!{st['conflicts']}", p["red"], st["conflicts"])]
            counts = [(t, c) for t, c, n in counts if n]
            tail = " ".join(t for t, _ in counts)
            branch_w = max(4, w - 4 - (len(tail) + 1 if tail else 0))
            x = 3 + cv.put(3, y + 1, fit(st["branch"], branch_w), p["cyan"] if not sel else p["bright"], bg)
            x += 1
            for t, c in counts:
                x += cv.put(x, y + 1, t, c, bg) + 1

    # input ------------------------------------------------------------------
    def click(self, i, button):
        self.sel = i
        if button == "left":
            self.open_repo(self.repos[i])

    def move(self, step):
        self.sel = max(0, min(len(self.repos) - 1, self.sel + step))

    def handle(self, ev):
        self.dirty = True
        if ev[0] == "mouse":
            _, action, button, x, y = ev
            if action == "wheel":
                visible = max(1, (self.size[1] - 3) // ROW_H)
                self.top = max(0, min(len(self.repos) - visible, self.top + (-1 if button == "up" else 1)))
                self.sel = max(self.top, min(self.sel, self.top + visible - 1))
            elif action == "press" and self.cv:
                fn = self.cv.hit_at(x, y)
                if fn:
                    fn(button)
            return
        _, mods, key = ev
        page = max(1, (self.size[1] - 3) // ROW_H)
        if key == "c" and mods == {"CTRL"} or key in ("q", "Escape") and not mods:
            self.running = False
        elif key in ("UpArrow", "k"):
            self.move(-1)
        elif key in ("DownArrow", "j"):
            self.move(1)
        elif key == "PageUp":
            self.move(-page)
        elif key == "PageDown":
            self.move(page)
        elif key == "End" or key == "g" and mods == {"SHIFT"}:
            self.sel = len(self.repos) - 1
        elif key in ("Home", "g"):
            self.sel = 0
        elif key in ("Enter", "RightArrow", "l") and not mods:
            self.open_repo(self.repos[self.sel])
        elif key == "r" and not mods:
            self.scan()
            self.refresher.done_at = self.ci_refresher.done_at = 0.0

    def run(self):
        import hivegrid_ui as U

        self.pal = palette()
        self.enter()
        signal.signal(signal.SIGWINCH, lambda *_: None)
        try:
            while self.running:
                try:
                    size = os.get_terminal_size(self.out.fileno())
                    size = (size.columns, size.lines)
                except OSError:
                    size = (30, 30)
                if size != self.size:
                    self.size = size
                    self.dirty = True
                if self.refresher.take() | self.ci_refresher.take():
                    self.dirty = True
                for rf in (self.refresher, self.ci_refresher):
                    if rf.due():
                        rf.kick(self.repos)
                if self.dirty:
                    self.draw()
                r, _, _ = select.select([self.fd], [], [], 0.2)
                if r:
                    data = os.read(self.fd, 4096)
                    if not data:
                        break
                    for ev in U.decode(data):
                        self.handle(ev)
        except KeyboardInterrupt:
            pass
        finally:
            self.leave()


def fit(text, width):
    if width <= 0:
        return ""
    return text if len(text) <= width else text[:max(0, width - 1)] + "…"


def palette():
    from hivegrid_settings_core import Settings, settings_path

    return Settings(settings_path()).theme()["palette"]


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    if argv[:1] in (["-h"], ["--help"]):
        print(__doc__.strip())
        return 0
    if len(argv) > 1:
        print("hivegrid-git: expected at most one directory (see --help)", file=sys.stderr)
        return 2
    root = os.path.realpath(argv[0] if argv else os.getcwd())
    if not os.path.isdir(root):
        print(f"hivegrid-git: not a directory: {root}", file=sys.stderr)
        return 2
    try:
        depth = int(os.environ.get("HIVEGRID_GIT_DEPTH", R.DEFAULT_DEPTH))
    except ValueError:
        depth = R.DEFAULT_DEPTH
    lazygit = lazygit_path()
    if not lazygit:
        print("hivegrid-git: lazygit not found (run install.sh --tools)", file=sys.stderr)
        return 127
    view = View(root, max(0, depth), lazygit)
    view.scan()
    if len(view.repos) <= 1:
        exec_lazygit(lazygit, view.repos[0].path if view.repos else root)
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        for r in view.repos:
            print(r.path)
        return 0
    view.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
