#!/usr/bin/env bash
set -euo pipefail

usage() {
  cat <<'EOF'
Usage: omp-grid [ROWS] [COLS] [DIR] [CMD]
       omp-grid [--layout grid|columns|main-side [N]] [options]

Run inside a WezTerm pane (or anywhere with --tab and a reachable mux).
Builds a layout of panes, one CMD (default omp) per pane.

Layouts:
  grid [ROWS [COLS]]  equal ROWSxCOLS grid (default; positional ROWS COLS)
  columns N           N equal side-by-side columns
  main-side N         one main pane (60% width) left, N equal panes stacked right

Options:
  --layout NAME [N]   layout (N is the count for columns / main-side)
  --rows N, --cols N  grid dimensions (default 2x2)
  --dirs d1,d2,...    per-pane directories in reading order, cycled if fewer than panes
  --dir DIR           directory for every pane (default $PWD)
  --cmd CMD           command to run in each pane (default omp)
  --name-panes        set pane titles agent-1..N via OSC 2
  --tab               build the layout in a new tab instead of the current pane
  -h, --help          show this help
EOF
}

rows=2 cols=2 dir=$PWD cmd=omp
layout=grid count="" count2=""
dirs_csv="" name_panes=0 new_tab=0
pos=()

while (($#)); do
  case $1 in
    -h | --help) usage; exit 0 ;;
    --layout)
      [ $# -ge 2 ] || { echo "--layout needs a value" >&2; exit 2; }
      layout=$2; shift 2
      if [ $# -gt 0 ] && [[ $1 =~ ^[0-9]+$ ]]; then count=$1; shift; fi
      # grid takes ROWS and COLS.
      if [ "$layout" = grid ] && [ -n "$count" ] && [ $# -gt 0 ] && [[ $1 =~ ^[0-9]+$ ]]; then
        count2=$1; shift
      fi ;;
    --rows) rows=${2:?--rows needs a value}; shift 2 ;;
    --cols) cols=${2:?--cols needs a value}; shift 2 ;;
    --dirs) dirs_csv=${2:?--dirs needs a value}; shift 2 ;;
    --dir) dir=${2:?--dir needs a value}; shift 2 ;;
    --cmd) cmd=${2:?--cmd needs a value}; shift 2 ;;
    --name-panes) name_panes=1; shift ;;
    --tab) new_tab=1; shift ;;
    --) shift; pos+=("$@"); break ;;
    -*) echo "unknown option: $1" >&2; usage >&2; exit 2 ;;
    *) pos+=("$1"); shift ;;
  esac
done

# Positional form: [ROWS] [COLS] [DIR] [CMD]
((${#pos[@]} > 0)) && rows=${pos[0]}
((${#pos[@]} > 1)) && cols=${pos[1]}
((${#pos[@]} > 2)) && dir=${pos[2]}
((${#pos[@]} > 3)) && cmd=${pos[3]}

num() { [[ $2 =~ ^[1-9][0-9]*$ ]] || { echo "$1 must be a positive integer: $2" >&2; exit 2; }; }
case $layout in
  grid) [ -z "$count" ] || rows=$count
        [ -z "$count2" ] || cols=$count2
        num ROWS "$rows"; num COLS "$cols" ;;
  columns) num "columns N" "${count:-$cols}"; rows=1; cols=${count:-$cols} ;;
  main-side) num "main-side N" "${count:-2}"; count=${count:-2} ;;
  *) echo "unknown layout: $layout" >&2; exit 2 ;;
esac

wez=$(command -v wezterm || echo "$HOME/.local/bin/wezterm")
cli() { "$wez" cli "$@"; }

dirs=()
if [ -n "$dirs_csv" ]; then
  IFS=, read -ra dirs <<<"$dirs_csv"
fi
[ ${#dirs[@]} -gt 0 ] || dirs=("$dir")
# The panes start in these directories through the mux, which does not know this shell's
# working directory: relative paths are resolved here, and a missing one stops early.
for i in "${!dirs[@]}"; do
  dirs[i]=$(cd "${dirs[i]}" 2>/dev/null && pwd) || { echo "no such directory: ${dirs[i]}" >&2; exit 2; }
done
dir_of() { printf '%s' "${dirs[$1 % ${#dirs[@]}]}"; }

if ((new_tab)); then
  base=$(cli spawn --cwd "$(dir_of 0)")
else
  [ -n "${WEZTERM_PANE:-}" ] || { echo "run inside a WezTerm pane (or use --tab)" >&2; exit 1; }
  base=$WEZTERM_PANE
fi

# Each split gives the new pane (k-1)/k of the remaining space so panes end up equal.
# split_equal HEAD DIRECTION N FIRST STEP: appends N-1 new panes to `new_panes`, equal along
# DIRECTION; the i-th new pane is pane number FIRST + (i-1)*STEP in reading order and starts
# in that pane's directory.
split_equal() {
  local last=$1 direction=$2 n=$3 first=$4 step=$5 i k
  for ((i = 1; i < n; i++)); do
    k=$((n - i + 1))
    last=$(cli split-pane --pane-id "$last" "--$direction" --percent $((100 * (k - 1) / k)) \
      --cwd "$(dir_of $((first + (i - 1) * step)))")
    new_panes+=("$last")
  done
}

panes=()
case $layout in
  grid | columns)
    new_panes=("$base")
    split_equal "$base" bottom "$rows" "$cols" "$cols"
    row_heads=("${new_panes[@]}")
    r=0
    for head in "${row_heads[@]}"; do
      panes+=("$head")
      new_panes=()
      split_equal "$head" right "$cols" $((r * cols + 1)) 1
      panes+=("${new_panes[@]}")
      r=$((r + 1))
    done ;;
  main-side)
    side=$(cli split-pane --pane-id "$base" --right --percent 40 --cwd "$(dir_of 1)")
    panes=("$base" "$side")
    new_panes=()
    split_equal "$side" bottom "$count" 2 1
    panes+=("${new_panes[@]}") ;;
esac

# Every pane but the current one (without --tab) already starts in its directory.
idx=0
for p in "${panes[@]}"; do
  d=$(dir_of "$idx")
  line=""
  ((name_panes)) && line+="printf '\\033]2;agent-$((idx + 1))\\007'; "
  if ((!new_tab && idx == 0)) && [ "$d" != "$PWD" ]; then
    line+="cd $(printf '%q' "$d") && "
  fi
  line+=$cmd
  printf '%s\n' "$line" | cli send-text --pane-id "$p" --no-paste
  idx=$((idx + 1))
done
