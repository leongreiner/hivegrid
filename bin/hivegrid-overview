#!/usr/bin/env python3
"""Hivegrid overview dock: a live list of the agent panes of one tab.

Runs in a narrow pane at the right edge of the tab (LEADER+o opens and closes it; see
config/overview.lua). The WezTerm config writes the state of every grid pane to
$XDG_RUNTIME_DIR/hivegrid-overview-$WEZTERM_PANE.json about once a second; this program only
draws it. Per pane: number (the minimap digit), state glyph, directory, how long it has been in
that state, and omp's session title; on the second line, right-aligned, the pane's git branch (cyan,
with a green / amber / red dot for clean / uncommitted changes / conflicts, and `◇ name` when the
pane runs in a linked worktree), resolved from the pane's directory and cached (hivegrid_repos.Where).
A click on a row, or its number on the keyboard, jumps to that pane (user var hivegrid_overview_goto, handled by the config; past pane 9 a digit that may
start a longer number waits a moment for the next one). j / k or the arrows (PageUp / PageDown,
g / G, Home / End) move the selection mark (it starts on, and follows, the active pane) and
Enter jumps to the selected pane. q or Esc closes the dock. With no blank line left between the
rows, every second row is shaded so the rows stay apart.
Closing: the ✕ at the right end of the row under the pointer (else the selected row), or x /
Delete for the selected row, closes that pane (user var hivegrid_overview_close); `✕ tab` in the
title row, or X, closes the whole tab. A pane whose close would interrupt work (close_need) and
the tab always ask first in place: y or the yes button closes, anything else keeps it.
The row and the ⊞ / ▦ button under the pointer fade to a lighter shade (about 150 ms in, 200 ms
out; frames only while a fade runs) and the pointer turns into a hand (OSC 22). The Hivegrid
build reports the pointer leaving the dock (DEC private mode 8800, a motion report at column 0,
row 0), which ends the hover. The dock sets its pane's default background (OSC 11) to its own
colour, so the window padding beside it is painted the same and it runs edge to edge.

Usage: hivegrid-overview [--file PATH] [--dump COLSxROWS]
  --file PATH        read the state from PATH instead of the pane's own file
  --dump COLSxROWS   print the rendering as plain text and exit (no terminal needed)
"""
import base64
import json
import os
import select
import signal
import sys
import termios
import time
import tty
import unicodedata

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import hivegrid_agents as A  # noqa: E402
import hivegrid_repos as R  # noqa: E402
import hivegrid_ui as U  # noqa: E402
from hivegrid_ui import decode, mix, split_complete  # noqa: E402

HOVER_BLEND = U.HOVER_BLEND
DIGIT_WAIT = 0.8  # seconds a typed digit waits for a second one when it may start a longer number
CLOSE_HIDE = 3.0  # seconds a closed pane's row stays hidden while the config has not dropped it


def state_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return f"{runtime}/hivegrid-overview-{os.environ.get('WEZTERM_PANE', '0')}.json"


def load(path):
    """The state document, or None while the config has not written it (or it is unreadable)."""
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) and isinstance(doc.get("panes"), list) else None


def with_git(doc, where):
    """The document with each pane's row carrying "git", where(cwd)'s answer (see
    hivegrid_repos.Where). A web pane has no directory, so it gets none."""
    if not doc:
        return doc
    return dict(doc, panes=[dict(p, git=where(p.get("cwd") or "")) if p.get("kind") != "web" else p
                            for p in doc["panes"]])


def clean(text):
    """Titles carry emoji, which take two cells while the canvas counts one per character: drop
    them (and the joiners and variation selectors that go with them) so rows keep their alignment."""
    out = []
    for ch in str(text):
        if ord(ch) >= 0x1F000 or unicodedata.east_asian_width(ch) in ("W", "F"):
            continue
        if unicodedata.category(ch) in ("Mn", "Me", "Cf", "Cc"):
            continue
        out.append(ch)
    return " ".join("".join(out).split())


def fit(text, n):
    return U.fit_cells(text, n)


def human(secs):
    secs = int(max(secs, 0))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h{secs % 3600 // 60:02d}m"
    return f"{secs // 86400}d{secs % 86400 // 3600:02d}h"


def hints(n, digits="", asking=False):
    """The footer's key hints as (key, label) pairs, most useful first (U.footer drops them from
    the end when narrow). `digits` is a pane number being typed; `asking`: a close waits for its
    answer."""
    if digits:
        return [(f"go to {digits}…", "")]
    if asking:
        return [("y", "close"), ("n", "keep")]
    return [("1" if n == 1 else f"1-{n}", "jump"), ("↵", "go"), ("q", "close"), ("e", "equalize"), ("a", "arrange"),
            ("x", "close pane")]


# Closing a pane from the dock loses nothing in these states: a shell at its prompt or the one an
# agent left behind, an agent between turns (omp saves its session as it goes; `omp --resume`
# brings it back), a web pane (a page; cookies and logins live in its profile). Any other state
# (working, busy, needs you, a bell, another program in the foreground, a pane not scanned yet)
# asks first, and the answer defaults to no. Closing the whole tab always asks: it takes every
# pane at once.
SAFE_TO_CLOSE = frozenset(("shell", "exited", "done", "idle", "web"))


def close_need(p):
    """True when closing the pane of row p would interrupt work, so the dock asks first."""
    return p.get("kind") not in SAFE_TO_CLOSE


def at_risk(panes):
    """[(kind, count)] of the panes whose close would interrupt work, most urgent first."""
    seen = {}
    for p in panes:
        if close_need(p):
            seen[p.get("kind")] = seen.get(p.get("kind"), 0) + 1
    kinds = sorted(seen, key=lambda k: (U.STATES[k].rank if k in U.STATES else len(U.STATES) + 1, str(k)))
    return [(k, seen[k]) for k in kinds]


def close_question(panes, pane_id=None):
    """The confirm question as candidates, longest first (the dock shows the first that fits);
    a candidate is a list of (text, state kind or None) segments, a state kind drawn in its
    colour. Closing pane `pane_id`: its number and what it is doing. With None, the whole tab:
    how many panes, and per state how many of them would be interrupted, in words and then as
    the title row's glyph counts when the words do not fit."""
    if pane_id is not None:
        p = next((p for p in panes if p.get("id") == pane_id), {})
        num = p.get("num", "?")
        what = clean(p.get("text") or "") or U.state_style(U.DEFAULT_PAL, p.get("kind"))[1]
        return [[(f"close {num} · {what}?", None)], [(f"close {num}?", None)]]
    n = len(panes)
    count = f"{n} pane" + ("" if n == 1 else "s")
    risk = at_risk(panes)
    if not risk:
        return [[(f"close tab · {count}?", None)], [("close tab?", None)]]
    words = ", ".join(f"{c} {U.STATES[k].label if k in U.STATES else k}" for k, c in risk)
    glyphs = []
    for k, c in risk:
        glyphs += [(" " if glyphs else "", None), (f"{U.state_style(U.DEFAULT_PAL, k)[0]}{c}", k)]
    return [[(f"close tab · {count} · {words}?", None)], [(f"close {count} · {words}?", None)],
            [(f"close {count}? ", None)] + glyphs, [("close all? ", None)] + glyphs,
            [("close? ", None)] + glyphs, [("close tab?", None)]]


def question_text(segments):
    return "".join(t for t, _ in segments)


def confirm_line(cv, pal, x, y, w, bg, questions, answer, hover):
    """A close question on one line over x..x+w: the longest question that fits in amber bold
    (state counts in their colours), then the `yes` and `no` buttons, 1 cell from the right end;
    `no` is the default (primary). answer(True|False) is called by a click on them."""
    cv.fill(x, y, w, 1, bg=bg)
    bx = x + w - 1 - U.chip_width("no")
    U.chip(cv, pal, bx, y, "no", kind="primary", hover=hover.get("ask_no", 0.0), bg=bg,
           hit=lambda button: answer(False), key="ask_no")
    bx -= 1 + U.chip_width("yes")
    U.chip(cv, pal, bx, y, "yes", kind="button", hover=hover.get("ask_yes", 0.0), bg=bg,
           hit=lambda button: answer(True), key="ask_yes")
    room = bx - 1 - x
    fits = next((q for q in questions if U.text_width(question_text(q)) <= room), None)
    if fits is None:
        cv.put(x, y, fit(question_text(questions[-1]), room), pal["amber"], bg, U.BOLD)
        return
    for text, kind in fits:
        x += cv.put(x, y, text, U.state_style(pal, kind)[2] if kind else pal["amber"], bg, U.BOLD)


def layout(n, avail, usage=False):
    """Rows per pane for n panes in `avail` rows: 4 (three lines and a blank, only with `usage`: the
    third line is the token and cost line), 3 (two lines and a blank), 2 (two lines) or 1."""
    for per in (4, 3, 2) if usage else (3, 2):
        if n * per - (1 if per >= 3 else 0) <= avail:
            return per
    return 1


def usage_of(p):
    """A pane's reported usage (hivegrid_agents.Usage) or None: shells and web panes have none."""
    return A.parse_usage(p.get("usage")) if p.get("kind") not in ("shell", "web") else None


def usage_segments(pal, p):
    """The token and cost line of an agent row as [(text, colour)]: muted (an estimated cost
    leads with `~`), and a dim `—` when the agent reported nothing. [] for a non-agent."""
    if p.get("kind") in ("shell", "web"):
        return []
    text = A.usage_text(usage_of(p))
    return [(text, pal["muted"])] if text else [("—", pal["dim"])]


def detail_of(p, name, mixed=False):
    """The first and second line of a row and how to cut the second ('start' for a path, whose end
    says more). An agent's own title is the first line: the directory name would only repeat
    "hivegrid" on every row of a grid that works in one repository. The directory moves to the
    second line when the panes work in different ones (`mixed`)."""
    # A shell titles its pane "user@host: dir"; the directory is the useful part.
    title = clean(p.get("title") or "")
    host, _, path = title.partition(": ")
    is_path = bool(path) and "@" in host and " " not in host
    title = U.home_path(path) if is_path else title
    # Without a title or reason the full directory, as shell rows show it.
    cwd = U.home_path(clean(p.get("cwd") or ""))
    # While the agent runs, what it is doing (a tool, a background job) says more than its
    # session title; otherwise the title does.
    reason = clean(p.get("reason") or "")
    working = p.get("kind") in ("working", "busy")
    if title and not is_path and title != name:
        sub = reason if working else (cwd if mixed else "")
        return title, sub, "start" if sub and sub == cwd else "end"
    fallback = cwd if cwd and cwd != name else clean(p.get("proc") or "")
    named = title if title and title != name else ""
    if working:
        detail = reason or named or fallback
    else:
        detail = named or reason or fallback
    return name, detail, "start" if detail and detail in (title if is_path else None, cwd) else "end"


WORKTREE = "◇"  # marks the worktree name of a pane that runs in a linked worktree
GIT_MIN_DETAIL = 12  # cells the second line keeps for its text before the git tag takes the rest
GIT_MIN_BRANCH = 4  # the branch is cut to this many cells before the tag shrinks further
GIT_BRANCH_KEPT = 10  # cells of the branch kept (or all of it) before the worktree tag gives way


def git_tag(pal, g, room):
    """The git tag of a pane's second line as [(text, colour)] and its width, fitted to `room`
    cells: the changes dot (green clean, amber uncommitted, red conflicts; none until read), the
    branch in cyan, then `◇ worktree` in muted when the pane runs in a linked worktree. It narrows
    from the end: the worktree's name goes first (the ◇ stays), then the ◇, then the branch is cut,
    and at the very end only the dot is left. `g` is hivegrid_repos.Where's answer (None outside a repository: no tag)."""
    if not g or room < 1:
        return [], 0
    dot = [("●", pal[g["dot"]])] if g.get("dot") in ("green", "amber", "red") else []
    gap = 1 if dot else 0
    branch = clean(g.get("branch") or "")
    if not branch:
        return dot, len(dot)
    name = clean(g["worktree"]) if g.get("worktree") else ""
    lead = len(dot) + gap
    # The worktree tag in full, then as the bare marker, then not at all; the first the branch
    # keeps GIT_BRANCH_KEPT cells (or all of it, when shorter) beside.
    options = [f"  {WORKTREE} {name}", f" {WORKTREE}"] if name else []
    keep = min(U.text_width(branch), GIT_BRANCH_KEPT)
    tail = next((t for t in options if room - lead - U.text_width(t) >= keep), "")
    tail_w = U.text_width(tail)
    branch_room = room - lead - tail_w
    if branch_room < min(GIT_MIN_BRANCH, U.text_width(branch)):
        return dot[:room], min(len(dot), room)
    branch = fit(branch, branch_room)
    segs = dot + [((" " if dot else "") + branch, pal["cyan"])] + ([(tail, pal["muted"])] if tail else [])
    return segs, sum(U.text_width(t) for t, _ in segs)


def render(doc, w, h, now, goto=None, equalize=None, arrange=None, hover=None, digits="", scroll=None, sel=None,
           close=None, close_tab=None, ask=None, answer=None, pointer=None):
    """Draws the overview into a w x h canvas. goto(pane_id) is called by a click on a row,
    equalize() by a click on ▦, arrange() by a click on ⊞. hover maps what the pointer is over
    (a pane id for a row, ('x', pane id) for a row's ✕, 'equalize', 'arrange', 'close_tab' or
    'ask_yes' / 'ask_no' for a button) to its fade level 0..1; `pointer` is the key the pointer
    is over now. digits is a pane number the user is typing (shown in the footer). sel is the
    pane id of the keyboard selection; None selects the active pane. close(pane_id) is called by
    a click on a row's ✕ (drawn on the row under the pointer, else on the selected row),
    close_tab() by the title row's `✕ tab`. ask is the close waiting for its answer: ('pane', id)
    puts the question into that row, ('tab', None) into the title row; answer(yes) is called by
    its buttons. The canvas carries start/last (the rows scrolled past) and sel (the pane id
    drawn selected)."""
    hover = hover or {}
    pal = dict(U.DEFAULT_PAL)
    pal.update((doc or {}).get("pal") or {})
    bg = pal["surface"]
    cv = U.Canvas(w, h, pal["text"], bg)
    cv.start, cv.last, cv.sel = 0, 0, None
    panes = doc["panes"] if doc else []
    # Header right: the number of panes per state in state colour, then the buttons: close the
    # tab (labelled, so it never reads as "close the dock"), arrange, equalize.
    seen = {}
    for p in panes:
        seen[p["kind"]] = seen.get(p["kind"], 0) + 1
    counts = []
    for kind in sorted(seen, key=lambda k: U.STATES.get(k, U.STATES["idle"]).rank):
        glyph, _, color = U.state_style(pal, kind)
        counts.append((f"{glyph}{seen[kind]}", color))
    chips = [U.Chip(label, lambda button, action=action: action(), name, hover.get(name, 0.0))
             for label, name, action in (("✕ tab", "close_tab", close_tab), ("⊞", "arrange", arrange),
                                         ("▦", "equalize", equalize)) if action]
    top = U.title_row(cv, pal, "Overview", right=counts if doc else (), chips=chips if doc else ())
    if doc is None:
        U.empty_state(cv, pal, 1, top.body + 1, w - 2, "Waiting for Hivegrid…",
                      "The config writes the panes of this tab about once a second.", bg=bg)
        return cv
    asking = ask is not None and answer is not None
    if asking and ask[0] == "tab":
        confirm_line(cv, pal, 1, 0, w - 1, bg, close_question(panes), answer, hover)

    # Token and cost telemetry: one muted line per agent row (when any agent reported something)
    # and, under the title, the total over the rows.
    has_usage = any(usage_of(p) for p in panes)
    total = A.totals_text(A.usage_totals(usage_of(p) for p in panes)) if has_usage else None
    first = top.body + (2 if total and h - top.body > 8 else 1 if total and h - top.body > 4 else 0)
    if first > top.body:
        cv.put(1, top.body, ("total " + total if U.text_width("total " + total) <= w - 2 else fit(total, w - 2)), pal["muted"])
    avail = h - first - 1  # rows between the title and the footer
    rows_per = layout(len(panes), avail, has_usage)
    lines = {4: 3, 3: 2, 2: 2, 1: 1}[rows_per]
    shown = max(avail // rows_per, 1) if panes else 0
    act = next((i for i, p in enumerate(panes) if p.get("active")), 0)
    cur = next((i for i, p in enumerate(panes) if p["id"] == sel), act)
    if panes:
        cv.sel = panes[cur]["id"]
    start = 0
    if len(panes) > shown:  # keep the last line for the note on the rows out of view
        shown = max((avail - 1) // rows_per, 1)
        last = len(panes) - shown
        if scroll is None:  # follow the selection
            start = min(max(cur - shown + 1, 0), last)
        else:
            start = min(max(scroll, 0), last)
        cv.start, cv.last = start, last
    mixed = len({p.get("cwd") or p.get("name") for p in panes}) > 1  # panes in different directories

    # Numbers take as many columns as the widest one, so names line up past pane 9.
    num_w = max((len(str(p["num"])) for p in panes), default=1)
    stripe = mix(bg, pal["raised"], U.STRIPE)
    y = first
    # The row ✕: on the row being asked about, else the row under the pointer, else the selected
    # row; one at a time, so buttons never stack on neighbouring rows.
    asked = ask[1] if asking and ask[0] == "pane" else None
    if asked is not None:
        x_row = asked
    elif isinstance(pointer, tuple) and pointer[0] == "x":
        x_row = pointer[1]
    elif any(p["id"] == pointer for p in panes):
        x_row = pointer
    else:  # (no row ✕ while the tab question is open)
        x_row = None if asking else cv.sel
    for k, p in enumerate(panes[start:start + shown]):
        glyph, label, color = U.state_style(pal, p["kind"], now)
        selected = p["id"] == cv.sel
        active = bool(p.get("active"))
        age = human(now - p["since"]) if p.get("since") else ""
        name = clean(p.get("name") or "").rstrip("/") or clean(p.get("proc") or "") or "?"
        name, detail, how = detail_of(p, name, mixed)
        right = f"{p.get('text') or label} {age}".strip()
        if U.text_width(right) + 1 + U.text_width(name) > w - 1 - (5 + num_w):
            right = age  # the state word goes first when the dock is narrow
        if lines == 1 or p["id"] == asked:
            detail = ""
        # The second line also carries the git tag (branch, worktree): right-aligned beside the
        # text it has, from the name column when there is none. The text keeps GIT_MIN_DETAIL cells.
        nx, tag, tag_w = 5 + num_w, [], 0
        if lines > 1 and p["id"] != asked:
            room = w - 1 - nx
            keep = min(U.text_width(detail), GIT_MIN_DETAIL) + 2 if detail else 0
            tag, tag_w = git_tag(pal, p.get("git"), room - keep)
            if tag and detail:
                detail = U.fit_text(detail, room - tag_w - 2, how)
        # Dense lists (no blank line between rows) stripe every second row so rows stay apart.
        row_bg = stripe if rows_per < 3 and (start + k) % 2 else bg
        action, lit = None, max(hover.get(p["id"], 0.0), hover.get(("x", p["id"]), 0.0))
        if p["id"] == asked:
            action = U.Action("✕", None, None, 1.0, "red")
        elif p["id"] == x_row and close:
            action = U.Action("✕", lambda button, pid=p["id"]: close(pid), ("x", p["id"]),
                              hover.get(("x", p["id"]), 0.0), "red")
        row = U.list_row(cv, pal, y, w=w, lines=lines, selected=selected, hover=lit, bg=row_bg,
                         glyph=glyph, glyph_color=color, num=p["num"], num_w=num_w,
                         num_color=pal["accent"] if active else None, name=name,
                         name_color=pal["bright"] if active else None, name_attrs=U.BOLD if active or selected else 0,
                         right=right, right_color=color, sub=detail, sub_fit=how,
                         hit=(lambda button, pid=p["id"]: goto(pid)) if goto else None, key=p["id"] if goto else None,
                         action=action)
        if tag:
            tx = w - 1 - tag_w if detail else nx
            for text, tint in tag:
                tx += cv.put(tx, y + 1, text, tint, row.bg)
        if lines > 2 and p["id"] != asked:  # the token and cost line, under the name
            ux = 5 + num_w
            for text, tint in usage_segments(pal, p):
                ux += cv.put(ux, y + 2, U.fit_text(text, w - 1 - ux, "end"), tint, row.bg)
        if p["id"] == asked:  # the question takes the second line, or a one-line row after its glyph
            qx, qy = (row.name_x, y + 1) if lines > 1 else (2, y)
            qw = (w if lines > 1 else row.end) - qx
            confirm_line(cv, pal, qx, qy, qw, row.bg, close_question(panes, asked), answer, hover)
        y += rows_per
    if cv.last:  # rows out of view, above and below
        above, below = start, cv.last - start
        note = "  ".join(t for t in (f"↑{above} more" if above else "", f"↓{below} more" if below else "") if t)
        cv.put(2, h - 2, fit(note + " · scroll", w - 3), pal["dim"])
    if digits:  # a number being typed replaces the hints, in the accent colour
        cv.put(1, h - 1, fit(hints(len(panes), digits)[0][0], w - 2), pal["accent"], bg, U.BOLD)
    else:
        U.footer(cv, pal, hints(len(panes), asking=asking), bg=bg)
    return cv


def dump(cv):
    return ["".join(c[0] for c in row).rstrip() for row in cv.cells]


class Dock:
    def __init__(self, path):
        self.path = path
        self.doc = None
        self.mtime = None
        self.fd = sys.stdin.fileno()
        self.out = sys.stdout
        self.running = True
        self.last = None
        self.cv = None
        self.scroll = None  # first row shown when the user scrolled with the wheel; None follows the selection
        self.active = None  # the active pane id the list last followed
        self.sel = None  # pane id of the keyboard selection; None: the active pane
        self.serial = 0
        self.fade = U.Hover()  # what the pointer is over (a pane id, ('x', id), a button key) and the fades
        self.digits = ""  # a pane number being typed (past pane 9 a digit may start a longer one)
        self.digits_at = 0.0  # monotonic time of the last typed digit
        self.bg = None  # the background colour last announced with OSC 11
        self.ask = None  # the close waiting for its answer: ('pane', pane id) or ('tab', None)
        self.closing = {}  # pane id -> monotonic time its close was sent (its row is hidden meanwhile)
        self.where = R.Where()  # branch and worktree per directory, cached

    def reload(self):
        try:
            mtime = os.stat(self.path).st_mtime_ns
        except OSError:
            mtime = None
        if mtime != self.mtime:
            self.mtime = mtime
            self.doc = load(self.path) if mtime is not None else None

    def request(self, name, payload):
        """Asks the config (user var) to act; the serial makes every request a change."""
        self.serial += 1
        value = base64.b64encode(f"{payload}:{self.serial}".encode()).decode()
        self.out.write(f"\x1b]1337;SetUserVar={name}={value}\x07")
        self.out.flush()

    def goto(self, pane_id):
        self.request("hivegrid_overview_goto", pane_id)

    def equalize(self, *_):
        self.request("hivegrid_overview_equalize", "")

    def arrange(self, *_):
        self.request("hivegrid_overview_arrange", "")

    def panes(self):
        """The rows of the document without the panes just closed: their rows go at once, the
        config drops them within a second; a close the config refused shows its row again after
        CLOSE_HIDE seconds."""
        now = time.monotonic()
        self.closing = {pid: t for pid, t in self.closing.items() if now - t < CLOSE_HIDE}
        return [p for p in (self.doc or {}).get("panes", []) if p["id"] not in self.closing]

    def close(self, pane_id, focus="grid"):
        """Closes the pane of a row: at once when nothing would be lost (close_need), else asks
        first. focus 'dock' keeps the keyboard in the dock afterwards (closed with a key), 'grid'
        gives it to the grid pane used last (closed with a click)."""
        p = next((p for p in self.panes() if p["id"] == pane_id), None)
        if p is None:
            return
        if close_need(p):
            self.ask = ("pane", pane_id)
        else:
            self.send_close(pane_id, focus)

    def close_tab(self, *_):
        """Asks before closing the whole tab (its grid panes, the bar and the dock)."""
        self.ask = ("tab", None)

    def answer(self, yes, focus="grid"):
        """The answer to the close question; anything but yes keeps everything."""
        ask, self.ask = self.ask, None
        if not yes or ask is None:
            return
        if ask[0] == "tab":
            self.request("hivegrid_overview_close", "tab")
        else:
            self.send_close(ask[1], focus)

    def send_close(self, pane_id, focus):
        ids = [p["id"] for p in self.panes()]
        if pane_id in ids and self.cv and self.cv.sel == pane_id and len(ids) > 1:
            # The selection moves on to the next row (the one before, past the end), so x x x
            # closes row after row; the config hands the grid over the same way.
            i = ids.index(pane_id)
            self.sel = ids[i + 1] if i + 1 < len(ids) else ids[i - 1]
        self.closing[pane_id] = time.monotonic()
        self.request("hivegrid_overview_close", f"pane:{pane_id}:{focus}")

    def number(self, key):
        """A typed digit: jumps as soon as the number is unambiguous, else waits DIGIT_WAIT for
        the next digit (with 12 panes, 1 may still become 10, 11 or 12)."""
        nums = {str(p.get("num")): p["id"] for p in self.panes()}
        typed = self.digits + key
        if not any(n.startswith(typed) for n in nums):
            typed = key
        if not any(n.startswith(typed) for n in nums):
            self.digits = ""
            return
        if typed in nums and not any(n != typed and n.startswith(typed) for n in nums):
            self.digits = ""
            self.goto(nums[typed])
            return
        self.digits, self.digits_at = typed, time.monotonic()

    def settle(self, now):
        """Jumps to a typed number once no further digit came; returns the seconds left to wait."""
        if not self.digits:
            return None
        left = self.digits_at + DIGIT_WAIT - now
        if left > 0:
            return left
        for p in self.panes():
            if str(p.get("num")) == self.digits:
                self.goto(p["id"])
        self.digits = ""
        return None

    def set_hover(self, key):
        """Starts the fade of what the pointer is now over, and asks for a hand pointer over a
        row or button, the default elsewhere (OSC 22, Hivegrid build)."""
        if self.fade.set(key):
            self.out.write(U.pointer_shape(key is not None))
            self.out.flush()

    def advance(self, now):
        """Moves every fade on by the time since the last step; True while one is still running."""
        return self.fade.advance(now)

    def move(self, step=None, to=None):
        """Moves the selection mark by `step` rows, or to row `to` (-1: the last)."""
        panes = self.panes()
        if not panes:
            return
        ids = [p["id"] for p in panes]
        cur = ids.index(self.cv.sel) if self.cv and self.cv.sel in ids else 0
        i = cur + step if to is None else to % len(ids)
        self.sel, self.scroll = ids[max(0, min(len(ids) - 1, i))], None

    def page(self):
        """Rows of panes in view (for PageUp / PageDown)."""
        if not self.cv or not self.doc:
            return 1
        return max(1, (self.cv.h - 3) // layout(len(self.panes()), self.cv.h - 3))

    def handle(self, ev):
        if ev[0] == "mouse":
            _, action, button, x, y = ev
            if action in ("drag", "press", "release"):  # motion without a button counts as a drag
                # A report at column 0, row 0 (x, y < 0 here) says the pointer left the dock.
                self.set_hover(self.cv.key_at(x, y) if self.cv and x >= 0 and y >= 0 else None)
            if action == "wheel" and self.cv and getattr(self.cv, "last", 0):
                # Rows past the dock's height: the wheel scrolls them; focusing another pane
                # makes the list follow the active pane again.
                base = self.cv.start if self.scroll is None else self.scroll
                self.scroll = min(max(base + (-1 if button == "up" else 1), 0), self.cv.last)
            if action == "press" and button == "left" and self.cv:
                if self.ask is not None and self.cv.key_at(x, y) not in ("ask_yes", "ask_no"):
                    self.answer(False)  # a click anywhere but on the question's buttons keeps the pane
                    return
                fn = self.cv.hit_at(x, y)
                if fn:
                    fn(button)
            return
        _, mods, key = ev
        if self.ask is not None:  # y closes; any other key (n, Esc, Enter: the default) keeps it
            self.answer(not mods and key == "y", "dock")
            return
        if mods == {"SHIFT"} and key in ("g", "x"):
            mods, key = set(), key.upper()
        if mods:
            return
        if key in ("q", "Escape"):
            self.running = False
        elif key == "e":
            self.equalize()
        elif key == "a":
            self.arrange()
        elif len(key) == 1 and key in "0123456789":
            self.number(key)
        elif key in ("DownArrow", "j"):
            self.move(1)
        elif key in ("UpArrow", "k"):
            self.move(-1)
        elif key == "PageDown":
            self.move(self.page())
        elif key == "PageUp":
            self.move(-self.page())
        elif key in ("Home", "g"):
            self.move(to=0)
        elif key in ("End", "G"):
            self.move(to=-1)
        elif key in ("Enter", "RightArrow", "l") and self.cv and self.cv.sel is not None:
            self.goto(self.cv.sel)
        elif key in ("x", "Delete") and self.cv and self.cv.sel is not None:
            self.close(self.cv.sel, "dock")
        elif key == "X":
            self.close_tab()

    def draw(self, size):
        cols, rows = size
        now = time.time()
        hover = self.fade.levels()
        # The active pane of the config's rows, even while its row is hidden after a close.
        active = next((p["id"] for p in (self.doc or {}).get("panes", []) if p.get("active")), None)
        if active != self.active:  # another pane got the focus: follow it again
            self.active, self.scroll, self.sel = active, None, None
        view = None if self.doc is None else with_git(dict(self.doc, panes=self.panes()), self.where)
        if self.ask and self.ask[0] == "pane" and (view is None or all(p["id"] != self.ask[1] for p in view["panes"])):
            self.ask = None  # the pane went away while the question was open
        self.cv = render(view, cols, rows, now, self.goto, self.equalize, self.arrange, hover, self.digits,
                         self.scroll, self.sel, self.close, self.close_tab, self.ask, self.answer, self.fade.key)
        frame = "\x1b[?25l" + self.cv.render()
        # The pane's default background takes the dock's colour, so WezTerm paints the window
        # padding beside the dock with it and the dock runs from the header to the bottom edge.
        if self.cv.bg != self.bg:
            self.bg = self.cv.bg
            frame = f"\x1b]11;{self.bg}\x07" + frame
        if frame != self.last:
            self.out.write(frame)
            self.out.flush()
            self.last = frame

    def run(self):
        old = termios.tcgetattr(self.fd)
        try:
            tty.setraw(self.fd)
            # Hivegrid build user vars: hivegrid_no_dim, the dock is chrome like the bar, so it is
            # drawn in its true colours rather than dimmed as an inactive pane; hivegrid_fixed_width,
            # a window resize or a new top-level split resizes the grid and leaves the dock's width.
            on = base64.b64encode(b"1").decode()
            self.out.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1003h\x1b[?1006h\x1b[?8800h"
                           f"\x1b]1337;SetUserVar=hivegrid_no_dim={on}\x07\x1b]1337;SetUserVar=hivegrid_fixed_width={on}\x07")
            self.out.flush()
            signal.signal(signal.SIGWINCH, lambda *_: None)
            tail = b""  # the start of an input sequence the last read cut off
            while self.running:
                self.reload()
                try:
                    size = os.get_terminal_size(self.out.fileno())
                    size = (size.columns, size.lines)
                except OSError:
                    size = (30, 24)
                fading = self.advance(time.monotonic())
                pending = self.settle(time.monotonic())
                self.draw(size)
                busy = any(p.get("kind") == "working" for p in (self.doc or {}).get("panes", []))
                wait = U.FRAME if fading else 0.125 if busy else 0.5
                r, _, _ = select.select([self.fd], [], [], min(wait, pending) if pending else wait)
                if r:
                    data = os.read(self.fd, 4096)
                    if not data:
                        break
                    # A motion report cut by the read boundary waits for its rest instead of
                    # turning into keystrokes; a lone ESC with nothing after it is the Escape key.
                    data, tail = split_complete(tail + data)
                elif tail:
                    data, tail = tail, b""
                else:
                    continue
                for ev in decode(data):
                    self.handle(ev)
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
            self.out.write("\x1b]22;\x07\x1b]111\x07\x1b[?8800l\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?25h\x1b[?1049l")
            self.out.flush()


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    path, dump_size = None, None
    while argv:
        a = argv.pop(0)
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--file" and argv:
            path = argv.pop(0)
        elif a == "--dump" and argv:
            try:
                cols, rows = argv.pop(0).lower().split("x")
                dump_size = (int(cols), int(rows))
            except ValueError:
                print("hivegrid-overview: --dump takes COLSxROWS", file=sys.stderr)
                return 2
        else:
            print(f"hivegrid-overview: unknown argument {a!r} (see --help)", file=sys.stderr)
            return 2
    path = path or state_path()
    if dump_size:
        print("\n".join(dump(render(with_git(load(path), R.Where(background=False)), *dump_size, time.time(), lambda _: None, lambda: None, lambda: None))))
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hivegrid-overview: needs a terminal (--dump prints one frame)", file=sys.stderr)
        return 2
    # A closed pane sends SIGHUP; leave through the normal path so the terminal is restored.
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(0))
    Dock(path).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
