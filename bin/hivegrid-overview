#!/usr/bin/env python3
"""Hivegrid overview dock: a live list of the agent panes of one tab.

Runs in a narrow pane at the right edge of the tab (LEADER+o opens and closes it; see
config/overview.lua). The WezTerm config writes the state of every grid pane to
$XDG_RUNTIME_DIR/hivegrid-overview-$WEZTERM_PANE.json about once a second; this program only
draws it. Per pane: number (the minimap digit), state glyph, directory, how long it has been in
that state, and omp's session title. A click on a row, or its digit on the keyboard, jumps to
that pane (user var hivegrid_overview_goto, handled by the config). q or Esc closes the dock.
The row and the ⊞ / ▦ button under the pointer fade to a lighter shade (about 150 ms in, 200 ms
out; frames only while a fade runs). The Hivegrid build reports the pointer leaving the dock
(DEC private mode 8800, a motion report at column 0, row 0), which ends the hover.

Usage: hivegrid-overview [--file PATH] [--dump COLSxROWS]
  --file PATH        read the state from PATH instead of the pane's own file
  --dump COLSxROWS   print the rendering as plain text and exit (no terminal needed)
"""
import base64
import json
import os
import select
import signal
import sys
import termios
import time
import tty
import unicodedata

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from hivegrid_ui import BOLD, DIM, Canvas, decode, mix  # noqa: E402

SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
ORDER = ("ask", "bell", "finished", "waiting", "working", "exited", "idle")
DEFAULT_PAL = {
    "deep": "#070d19", "base": "#0b1220", "surface": "#111b30", "text": "#c9d6ee", "bright": "#eaf1ff",
    "muted": "#8a9cc2", "dim": "#7487ad", "accent": "#4f9dff", "raised": "#1d3a70", "border": "#1e2a45",
}
STEPS = 8  # shades between rest and full hover: the fade is drawn in this many steps
HOVER_BLEND = 0.45  # share of the way to the hover colour that full hover reaches
FADE_IN, FADE_OUT = 0.15, 0.20  # seconds from rest to full hover and back
FRAME = 1 / 30  # seconds between frames while a fade runs


def state_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return f"{runtime}/hivegrid-overview-{os.environ.get('WEZTERM_PANE', '0')}.json"


def load(path):
    """The state document, or None while the config has not written it (or it is unreadable)."""
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) and isinstance(doc.get("panes"), list) else None


def clean(text):
    """Titles carry emoji, which take two cells while the canvas counts one per character: drop
    them (and the joiners and variation selectors that go with them) so rows keep their alignment."""
    out = []
    for ch in str(text):
        if ord(ch) >= 0x1F000 or unicodedata.east_asian_width(ch) in ("W", "F"):
            continue
        if unicodedata.category(ch) in ("Mn", "Me", "Cf", "Cc"):
            continue
        out.append(ch)
    return " ".join("".join(out).split())


def fit(text, n):
    return text if len(text) <= n else text[: max(n - 1, 0)] + "…"


def human(secs):
    secs = int(max(secs, 0))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h{secs % 3600 // 60:02d}m"
    return f"{secs // 86400}d{secs % 86400 // 3600:02d}h"


def render(doc, w, h, now, goto=None, equalize=None, arrange=None, hover=None):
    """Draws the overview into a w x h canvas. goto(pane_id) is called by a click on a row,
    equalize() by a click on ▦, arrange() by a click on ⊞. hover maps what the pointer is over
    (a pane id for a row, 'equalize' or 'arrange' for a header button) to its fade level 0..1."""
    hover = hover or {}
    pal = dict(DEFAULT_PAL)
    pal.update((doc or {}).get("pal") or {})
    cv = Canvas(w, h, pal["text"], pal["surface"])
    cv.fill(0, 0, w, 1, bg=pal["surface"])
    cv.put(1, 0, "⬡ Overview", pal["accent"], pal["surface"], BOLD)
    cv.fill(0, 1, w, 1, bg=pal["surface"], fg=pal["border"], ch="─")
    if doc is None:
        cv.put(1, 3, "waiting for Hivegrid…", pal["muted"])
        return cv
    panes = doc["panes"]

    # Header right: the buttons (arrange, equalize), left of them the number of panes per
    # state in state colour.
    x = w - 1
    for label, name, action in ((" ▦ ", "equalize", equalize), (" ⊞ ", "arrange", arrange)):
        if action:
            x -= len(label)
            bg = mix(pal["raised"], pal["accent"], HOVER_BLEND * hover.get(name, 0.0))
            cv.put(x, 0, label, pal["bright"], bg, BOLD)
            cv.hit(x, 0, len(label), 1, lambda button, action=action: action(), key=name)
            x -= 1
    seen = {}
    for p in panes:
        seen.setdefault(p["kind"], [p["glyph"], p["color"], 0])[2] += 1
    for kind in sorted(seen, key=lambda k: ORDER.index(k) if k in ORDER else len(ORDER), reverse=True):
        glyph, color, n = seen[kind]
        text = f"{glyph}{n}"
        if x - len(text) - 1 < 12:
            break
        x -= len(text)
        cv.put(x, 0, text, color, pal["surface"])
        x -= 1

    rows_per = 1
    avail = h - 3  # header, rule, hint line
    for per in (3, 2):  # two lines and a blank, or two lines
        if len(panes) * per - (1 if per == 3 else 0) <= avail:
            rows_per = per
            break
    two_lines = rows_per > 1
    shown = max(avail // rows_per, 1) if panes else 0
    hidden = max(len(panes) - shown, 0)
    if hidden:  # keep the last line for the "+n more" note
        shown = max((avail - 1) // rows_per, 1)
        hidden = len(panes) - shown

    frame = int(now * 8) % len(SPINNER)
    y = 2
    for p in panes[:shown]:
        active = bool(p.get("active"))
        lit = hover.get(p["id"], 0.0)
        bg = pal["raised"] if active else mix(pal["surface"], pal["raised"], HOVER_BLEND * lit)
        lines = 2 if two_lines else 1
        cv.fill(0, y, w, lines, bg=bg)
        if active:
            cv.fill(0, y, 1, lines, fg=pal["accent"], ch="▎")
        glyph = SPINNER[frame] if p["kind"] == "working" else p["glyph"]
        cv.put(2, y, glyph, p["color"], bg, BOLD)
        cv.put(4, y, str(p["num"]), pal["accent"] if active else pal["muted"], bg, BOLD)
        age = human(now - p["since"]) if p.get("since") else ""
        right = f"{p['text']} {age}".strip()
        name = clean(p.get("name") or "") or clean(p.get("proc") or "") or "?"
        zoom = " ⤢" if p.get("zoomed") else ""
        room = w - 7 - 1
        if len(right) + 1 + len(name) + len(zoom) > room:
            right = age  # the state word goes first when the dock is narrow
        name = fit(name, max(room - len(right) - 1 - len(zoom), 3))
        cv.put(6, y, name + zoom, pal["bright"] if active else pal["text"], bg, BOLD if active else 0)
        cv.put(w - 1 - len(right), y, right, p["color"], bg)
        if two_lines:
            title = clean(p.get("title") or "")
            proc = clean(p.get("proc") or "")
            detail = title if title and title != name else proc
            cv.put(6, y + 1, fit(detail, w - 7), pal["muted"], bg)
        if goto:
            cv.hit(0, y, w, lines, lambda button, pid=p["id"]: goto(pid), key=p["id"])
        y += rows_per
    if hidden:
        cv.put(2, h - 2, f"+{hidden} more", pal["dim"])
    cv.put(1, h - 1, fit("1-9 jump · e ▦ · a ⊞ · q", w - 2), pal["dim"], pal["surface"], DIM)
    return cv


def dump(cv):
    return ["".join(c[0] for c in row).rstrip() for row in cv.cells]


class Dock:
    def __init__(self, path):
        self.path = path
        self.doc = None
        self.mtime = None
        self.fd = sys.stdin.fileno()
        self.out = sys.stdout
        self.running = True
        self.last = None
        self.cv = None
        self.serial = 0
        self.hover = None  # what the pointer is over: a pane id, 'equalize', 'arrange' or None
        self.levels = {}  # fade level 0..1 of every key that is hovered or still fading out
        self.clock = None  # time of the last fade step; None while no fade runs

    def reload(self):
        try:
            mtime = os.stat(self.path).st_mtime_ns
        except OSError:
            mtime = None
        if mtime != self.mtime:
            self.mtime = mtime
            self.doc = load(self.path) if mtime is not None else None

    def request(self, name, payload):
        """Asks the config (user var) to act; the serial makes every request a change."""
        self.serial += 1
        value = base64.b64encode(f"{payload}:{self.serial}".encode()).decode()
        self.out.write(f"\x1b]1337;SetUserVar={name}={value}\x07")
        self.out.flush()

    def goto(self, pane_id):
        self.request("hivegrid_overview_goto", pane_id)

    def equalize(self, *_):
        self.request("hivegrid_overview_equalize", "")

    def arrange(self, *_):
        self.request("hivegrid_overview_arrange", "")

    def number(self, n):
        for p in (self.doc or {}).get("panes", []):
            if p.get("num") == n:
                self.goto(p["id"])
                return

    def set_hover(self, key):
        if key != self.hover:
            self.hover = key
            if self.clock is None:
                self.clock = time.monotonic()

    def advance(self, now):
        """Moves every fade on by the time since the last step; True while one is still running."""
        dt = 0.0 if self.clock is None else max(now - self.clock, 0.0)
        busy = False
        for key in set(self.levels) | ({self.hover} - {None}):
            target = 1.0 if key == self.hover else 0.0
            level = self.levels.get(key, 0.0)
            if level < target:
                level = min(target, level + dt / FADE_IN)
            elif level > target:
                level = max(target, level - dt / FADE_OUT)
            if level:
                self.levels[key] = level
            else:
                self.levels.pop(key, None)
            busy = busy or level != target
        self.clock = now if busy else None
        return busy

    def handle(self, ev):
        if ev[0] == "mouse":
            _, action, button, x, y = ev
            if action in ("drag", "press", "release"):  # motion without a button counts as a drag
                # A report at column 0, row 0 (x, y < 0 here) says the pointer left the dock.
                self.set_hover(self.cv.key_at(x, y) if self.cv and x >= 0 and y >= 0 else None)
            if action == "press" and button == "left" and self.cv:
                fn = self.cv.hit_at(x, y)
                if fn:
                    fn(button)
            return
        _, mods, key = ev
        if not mods and key in ("q", "Escape"):
            self.running = False
        elif not mods and key == "e":
            self.equalize()
        elif not mods and key == "a":
            self.arrange()
        elif not mods and len(key) == 1 and key in "123456789":
            self.number(int(key))

    def draw(self, size):
        cols, rows = size
        now = time.time()
        hover = {k: round(v * STEPS) / STEPS for k, v in self.levels.items()}
        self.cv = render(self.doc, cols, rows, now, self.goto, self.equalize, self.arrange, hover)
        frame = "\x1b[?25l" + self.cv.render()
        if frame != self.last:
            self.out.write(frame)
            self.out.flush()
            self.last = frame

    def run(self):
        old = termios.tcgetattr(self.fd)
        try:
            tty.setraw(self.fd)
            self.out.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1003h\x1b[?1006h\x1b[?8800h")
            self.out.flush()
            signal.signal(signal.SIGWINCH, lambda *_: None)
            while self.running:
                self.reload()
                try:
                    size = os.get_terminal_size(self.out.fileno())
                    size = (size.columns, size.lines)
                except OSError:
                    size = (30, 24)
                fading = self.advance(time.monotonic())
                self.draw(size)
                busy = any(p.get("kind") == "working" for p in (self.doc or {}).get("panes", []))
                r, _, _ = select.select([self.fd], [], [], FRAME if fading else 0.125 if busy else 0.5)
                if r:
                    data = os.read(self.fd, 4096)
                    if not data:
                        break
                    for ev in decode(data):
                        self.handle(ev)
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
            self.out.write("\x1b[?8800l\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?25h\x1b[?1049l")
            self.out.flush()


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    path, dump_size = None, None
    while argv:
        a = argv.pop(0)
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--file" and argv:
            path = argv.pop(0)
        elif a == "--dump" and argv:
            try:
                cols, rows = argv.pop(0).lower().split("x")
                dump_size = (int(cols), int(rows))
            except ValueError:
                print("hivegrid-overview: --dump takes COLSxROWS", file=sys.stderr)
                return 2
        else:
            print(f"hivegrid-overview: unknown argument {a!r} (see --help)", file=sys.stderr)
            return 2
    path = path or state_path()
    if dump_size:
        print("\n".join(dump(render(load(path), *dump_size, time.time(), lambda _: None, lambda: None, lambda: None))))
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hivegrid-overview: needs a terminal (--dump prints one frame)", file=sys.stderr)
        return 2
    # A closed pane sends SIGHUP; leave through the normal path so the terminal is restored.
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(0))
    Dock(path).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
