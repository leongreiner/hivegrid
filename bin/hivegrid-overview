#!/usr/bin/env python3
"""Hivegrid overview dock: a live list of the agent panes of one tab.

Runs in a narrow pane at the right edge of the tab (LEADER+o opens and closes it; see
config/overview.lua). The WezTerm config writes the state of every grid pane to
$XDG_RUNTIME_DIR/hivegrid-overview-$WEZTERM_PANE.json about once a second; this program only
draws it. Per pane: number (the minimap digit), state glyph, directory, how long it has been in
that state, and omp's session title. A click on a row, or its number on the keyboard, jumps to
that pane (user var hivegrid_overview_goto, handled by the config; past pane 9 a digit that may
start a longer number waits a moment for the next one). q or Esc closes the dock.
The row and the ⊞ / ▦ button under the pointer fade to a lighter shade (about 150 ms in, 200 ms
out; frames only while a fade runs) and the pointer turns into a hand (OSC 22). The Hivegrid
build reports the pointer leaving the dock (DEC private mode 8800, a motion report at column 0,
row 0), which ends the hover. The dock sets its pane's default background (OSC 11) to its own
colour, so the window padding beside it is painted the same and it runs edge to edge.

Usage: hivegrid-overview [--file PATH] [--dump COLSxROWS]
  --file PATH        read the state from PATH instead of the pane's own file
  --dump COLSxROWS   print the rendering as plain text and exit (no terminal needed)
"""
import base64
import json
import os
import select
import signal
import sys
import termios
import time
import tty
import unicodedata

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from hivegrid_ui import BOLD, Canvas, decode, mix, split_complete  # noqa: E402

SPINNER = "⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"
ORDER = ("attention", "bell", "done", "idle", "busy", "working", "other", "exited", "shell")
DEFAULT_PAL = {
    "deep": "#070d19", "base": "#0b1220", "surface": "#111b30", "text": "#c9d6ee", "bright": "#eaf1ff",
    "muted": "#8a9cc2", "dim": "#7487ad", "accent": "#4f9dff", "raised": "#1d3a70", "border": "#1e2a45",
}
STEPS = 8  # shades between rest and full hover: the fade is drawn in this many steps
HOVER_BLEND = 0.45  # share of the way to the hover colour that full hover reaches
FADE_IN, FADE_OUT = 0.15, 0.20  # seconds from rest to full hover and back
FRAME = 1 / 30  # seconds between frames while a fade runs
DIGIT_WAIT = 0.8  # seconds a typed digit waits for a second one when it may start a longer number


def state_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return f"{runtime}/hivegrid-overview-{os.environ.get('WEZTERM_PANE', '0')}.json"


def load(path):
    """The state document, or None while the config has not written it (or it is unreadable)."""
    try:
        with open(path, encoding="utf-8") as f:
            doc = json.load(f)
    except (OSError, ValueError):
        return None
    return doc if isinstance(doc, dict) and isinstance(doc.get("panes"), list) else None


def clean(text):
    """Titles carry emoji, which take two cells while the canvas counts one per character: drop
    them (and the joiners and variation selectors that go with them) so rows keep their alignment."""
    out = []
    for ch in str(text):
        if ord(ch) >= 0x1F000 or unicodedata.east_asian_width(ch) in ("W", "F"):
            continue
        if unicodedata.category(ch) in ("Mn", "Me", "Cf", "Cc"):
            continue
        out.append(ch)
    return " ".join("".join(out).split())


def fit(text, n):
    return text if len(text) <= n else text[: max(n - 1, 0)] + "…"


def human(secs):
    secs = int(max(secs, 0))
    if secs < 60:
        return f"{secs}s"
    if secs < 3600:
        return f"{secs // 60}m"
    if secs < 86400:
        return f"{secs // 3600}h{secs % 3600 // 60:02d}m"
    return f"{secs // 86400}d{secs % 86400 // 3600:02d}h"


def hints(n, w, digits=""):
    """The key-hint footer, as long as the width allows. `digits` is a pane number being typed."""
    if digits:
        return f"go to {digits}…"
    jump = "1 jump" if n == 1 else f"1-{n} jump"
    for text in (f"{jump}  e equalize  a arrange  q close", f"{jump}  e ▦  a ⊞  q close", f"{jump}  q close"):
        if len(text) <= w:
            return text
    return ""


def render(doc, w, h, now, goto=None, equalize=None, arrange=None, hover=None, digits="", scroll=None):
    """Draws the overview into a w x h canvas. goto(pane_id) is called by a click on a row,
    equalize() by a click on ▦, arrange() by a click on ⊞. hover maps what the pointer is over
    (a pane id for a row, 'equalize' or 'arrange' for a header button) to its fade level 0..1.
    digits is a pane number the user is typing (shown in the footer)."""
    hover = hover or {}
    pal = dict(DEFAULT_PAL)
    pal.update((doc or {}).get("pal") or {})
    cv = Canvas(w, h, pal["text"], pal["surface"])
    cv.fill(0, 0, w, 1, bg=pal["surface"])
    cv.put(1, 0, "⬡ Overview", pal["accent"], pal["surface"], BOLD)
    cv.fill(0, 1, w, 1, bg=pal["surface"], fg=pal["border"], ch="─")
    if doc is None:
        cv.put(1, 3, "waiting for Hivegrid…", pal["muted"])
        return cv
    panes = doc["panes"]

    # Header right: the buttons (arrange, equalize), left of them the number of panes per
    # state in state colour.
    x = w - 1
    for label, name, action in ((" ▦ ", "equalize", equalize), (" ⊞ ", "arrange", arrange)):
        if action:
            x -= len(label)
            bg = mix(pal["raised"], pal["accent"], HOVER_BLEND * hover.get(name, 0.0))
            cv.put(x, 0, label, pal["bright"], bg, BOLD)
            cv.hit(x, 0, len(label), 1, lambda button, action=action: action(), key=name)
            x -= 1
    seen = {}
    for p in panes:
        seen.setdefault(p["kind"], [p["glyph"], p["color"], 0])[2] += 1
    for kind in sorted(seen, key=lambda k: ORDER.index(k) if k in ORDER else len(ORDER), reverse=True):
        glyph, color, n = seen[kind]
        text = f"{glyph}{n}"
        if x - len(text) - 1 < 12:
            break
        x -= len(text)
        cv.put(x, 0, text, color, pal["surface"])
        x -= 1

    rows_per = 1
    avail = h - 3  # header, rule, hint line
    for per in (3, 2):  # two lines and a blank, or two lines
        if len(panes) * per - (1 if per == 3 else 0) <= avail:
            rows_per = per
            break
    two_lines = rows_per > 1
    shown = max(avail // rows_per, 1) if panes else 0
    start = 0
    if len(panes) > shown:  # keep the last line for the note on the rows out of view
        shown = max((avail - 1) // rows_per, 1)
        last = len(panes) - shown
        if scroll is None:  # follow the active pane
            act = next((i for i, p in enumerate(panes) if p.get("active")), 0)
            start = min(max(act - shown + 1, 0), last)
        else:
            start = min(max(scroll, 0), last)
    cv.start, cv.last = start, max(len(panes) - shown, 0)

    frame = int(now * 8) % len(SPINNER)
    # Numbers take as many columns as the widest one, so names line up past pane 9.
    nx = 4 + max((len(str(p["num"])) for p in panes), default=1) + 1
    y = 2
    for p in panes[start:start + shown]:
        active = bool(p.get("active"))
        lit = hover.get(p["id"], 0.0)
        bg = pal["raised"] if active else mix(pal["surface"], pal["raised"], HOVER_BLEND * lit)
        lines = 2 if two_lines else 1
        cv.fill(0, y, w, lines, bg=bg)
        if active:
            cv.fill(0, y, 1, lines, fg=pal["accent"], ch="▎")
        glyph = SPINNER[frame] if p["kind"] == "working" else p["glyph"]
        cv.put(2, y, glyph, p["color"], bg, BOLD)
        cv.put(4, y, str(p["num"]), pal["accent"] if active else pal["muted"], bg, BOLD)
        age = human(now - p["since"]) if p.get("since") else ""
        right = f"{p['text']} {age}".strip()
        name = clean(p.get("name") or "") or clean(p.get("proc") or "") or "?"
        room = w - nx - 2
        if len(right) + 1 + len(name) > room:
            right = age  # the state word goes first when the dock is narrow
        name = fit(name, max(room - len(right) - 1, 3))
        cv.put(nx, y, name, pal["bright"] if active else pal["text"], bg, BOLD if active else 0)
        cv.put(w - 1 - len(right), y, right, p["color"], bg)
        if two_lines:
            # A shell titles its pane "user@host: dir"; the directory is the useful part, and its
            # end says more than its start when it has to be cut.
            title = clean(p.get("title") or "")
            host, _, path = title.partition(": ")
            is_path = bool(path) and "@" in host and " " not in host
            title = path if is_path else title
            proc = clean(p.get("proc") or "")
            # While the agent runs, what it is doing (a tool, a background job) says more than
            # its session title; otherwise the title does.
            reason = clean(p.get("reason") or "")
            named = title if title and title != name else ""
            if p.get("kind") in ("working", "busy"):
                detail = reason or named or proc
            else:
                detail = named or reason or proc
            room = w - nx - 1
            if is_path and detail == title and len(detail) > room:
                detail = "…" + detail[len(detail) - room + 1:] if room > 1 else ""
            cv.put(nx, y + 1, fit(detail, room), pal["muted"], bg)
        if goto:
            cv.hit(0, y, w, lines, lambda button, pid=p["id"]: goto(pid), key=p["id"])
        y += rows_per
    if cv.last:  # rows out of view, above and below
        above, below = start, cv.last - start
        note = "  ".join(t for t in (f"↑{above} more" if above else "", f"↓{below} more" if below else "") if t)
        cv.put(2, h - 2, fit(note + " · scroll", w - 3), pal["dim"])
    # Key hints as in the panels: the key in text colour, its label muted. A number being typed
    # replaces them, in the accent colour.
    x = 1
    if digits:
        cv.put(x, h - 1, hints(len(panes), w - 2, digits), pal["accent"], pal["surface"], BOLD)
        return cv
    for k, pair in enumerate(hints(len(panes), w - 2, digits).split("  ")):
        key, _, label = pair.partition(" ")
        x += 2 if k else 0
        x += cv.put(x, h - 1, key, pal["text"], pal["surface"])
        if label:
            x += cv.put(x, h - 1, " " + label, pal["muted"], pal["surface"])
    return cv


def dump(cv):
    return ["".join(c[0] for c in row).rstrip() for row in cv.cells]


class Dock:
    def __init__(self, path):
        self.path = path
        self.doc = None
        self.mtime = None
        self.fd = sys.stdin.fileno()
        self.out = sys.stdout
        self.running = True
        self.last = None
        self.cv = None
        self.scroll = None  # first row shown when the user scrolled with the wheel; None follows the active pane
        self.active = None  # the active pane id the list last followed
        self.serial = 0
        self.hover = None  # what the pointer is over: a pane id, 'equalize', 'arrange' or None
        self.levels = {}  # fade level 0..1 of every key that is hovered or still fading out
        self.clock = None  # time of the last fade step; None while no fade runs
        self.digits = ""  # a pane number being typed (past pane 9 a digit may start a longer one)
        self.digits_at = 0.0  # monotonic time of the last typed digit
        self.bg = None  # the background colour last announced with OSC 11

    def reload(self):
        try:
            mtime = os.stat(self.path).st_mtime_ns
        except OSError:
            mtime = None
        if mtime != self.mtime:
            self.mtime = mtime
            self.doc = load(self.path) if mtime is not None else None

    def request(self, name, payload):
        """Asks the config (user var) to act; the serial makes every request a change."""
        self.serial += 1
        value = base64.b64encode(f"{payload}:{self.serial}".encode()).decode()
        self.out.write(f"\x1b]1337;SetUserVar={name}={value}\x07")
        self.out.flush()

    def goto(self, pane_id):
        self.request("hivegrid_overview_goto", pane_id)

    def equalize(self, *_):
        self.request("hivegrid_overview_equalize", "")

    def arrange(self, *_):
        self.request("hivegrid_overview_arrange", "")

    def number(self, key):
        """A typed digit: jumps as soon as the number is unambiguous, else waits DIGIT_WAIT for
        the next digit (with 12 panes, 1 may still become 10, 11 or 12)."""
        nums = {str(p.get("num")): p["id"] for p in (self.doc or {}).get("panes", [])}
        typed = self.digits + key
        if not any(n.startswith(typed) for n in nums):
            typed = key
        if not any(n.startswith(typed) for n in nums):
            self.digits = ""
            return
        if typed in nums and not any(n != typed and n.startswith(typed) for n in nums):
            self.digits = ""
            self.goto(nums[typed])
            return
        self.digits, self.digits_at = typed, time.monotonic()

    def settle(self, now):
        """Jumps to a typed number once no further digit came; returns the seconds left to wait."""
        if not self.digits:
            return None
        left = self.digits_at + DIGIT_WAIT - now
        if left > 0:
            return left
        for p in (self.doc or {}).get("panes", []):
            if str(p.get("num")) == self.digits:
                self.goto(p["id"])
        self.digits = ""
        return None

    def set_hover(self, key):
        """Starts the fade of what the pointer is now over, and asks for a hand pointer over a
        row or button, the default elsewhere (OSC 22, Hivegrid build)."""
        if key != self.hover:
            prior, self.hover = self.hover, key
            if self.clock is None:
                self.clock = time.monotonic()
            if (prior is None) != (key is None):
                self.out.write("\x1b]22;" + ("pointer" if key is not None else "") + "\x07")
                self.out.flush()

    def advance(self, now):
        """Moves every fade on by the time since the last step; True while one is still running."""
        dt = 0.0 if self.clock is None else max(now - self.clock, 0.0)
        busy = False
        for key in set(self.levels) | ({self.hover} - {None}):
            target = 1.0 if key == self.hover else 0.0
            level = self.levels.get(key, 0.0)
            if level < target:
                level = min(target, level + dt / FADE_IN)
            elif level > target:
                level = max(target, level - dt / FADE_OUT)
            if level:
                self.levels[key] = level
            else:
                self.levels.pop(key, None)
            busy = busy or level != target
        self.clock = now if busy else None
        return busy

    def handle(self, ev):
        if ev[0] == "mouse":
            _, action, button, x, y = ev
            if action in ("drag", "press", "release"):  # motion without a button counts as a drag
                # A report at column 0, row 0 (x, y < 0 here) says the pointer left the dock.
                self.set_hover(self.cv.key_at(x, y) if self.cv and x >= 0 and y >= 0 else None)
            if action == "wheel" and self.cv and getattr(self.cv, "last", 0):
                # Rows past the dock's height: the wheel scrolls them; focusing another pane
                # makes the list follow the active pane again.
                base = self.cv.start if self.scroll is None else self.scroll
                self.scroll = min(max(base + (-1 if button == "up" else 1), 0), self.cv.last)
            if action == "press" and button == "left" and self.cv:
                fn = self.cv.hit_at(x, y)
                if fn:
                    fn(button)
            return
        _, mods, key = ev
        if not mods and key in ("q", "Escape"):
            self.running = False
        elif not mods and key == "e":
            self.equalize()
        elif not mods and key == "a":
            self.arrange()
        elif not mods and len(key) == 1 and key in "0123456789":
            self.number(key)

    def draw(self, size):
        cols, rows = size
        now = time.time()
        hover = {k: round(v * STEPS) / STEPS for k, v in self.levels.items()}
        active = next((p["id"] for p in (self.doc or {}).get("panes", []) if p.get("active")), None)
        if active != self.active:
            self.active, self.scroll = active, None
        self.cv = render(self.doc, cols, rows, now, self.goto, self.equalize, self.arrange, hover, self.digits,
                         self.scroll)
        frame = "\x1b[?25l" + self.cv.render()
        # The pane's default background takes the dock's colour, so WezTerm paints the window
        # padding beside the dock with it and the dock runs from the header to the bottom edge.
        if self.cv.bg != self.bg:
            self.bg = self.cv.bg
            frame = f"\x1b]11;{self.bg}\x07" + frame
        if frame != self.last:
            self.out.write(frame)
            self.out.flush()
            self.last = frame

    def run(self):
        old = termios.tcgetattr(self.fd)
        try:
            tty.setraw(self.fd)
            # Hivegrid build user vars: hivegrid_no_dim, the dock is chrome like the bar, so it is
            # drawn in its true colours rather than dimmed as an inactive pane; hivegrid_fixed_width,
            # a window resize or a new top-level split resizes the grid and leaves the dock's width.
            on = base64.b64encode(b"1").decode()
            self.out.write("\x1b[?1049h\x1b[?25l\x1b[?1000h\x1b[?1003h\x1b[?1006h\x1b[?8800h"
                           f"\x1b]1337;SetUserVar=hivegrid_no_dim={on}\x07\x1b]1337;SetUserVar=hivegrid_fixed_width={on}\x07")
            self.out.flush()
            signal.signal(signal.SIGWINCH, lambda *_: None)
            tail = b""  # the start of an input sequence the last read cut off
            while self.running:
                self.reload()
                try:
                    size = os.get_terminal_size(self.out.fileno())
                    size = (size.columns, size.lines)
                except OSError:
                    size = (30, 24)
                fading = self.advance(time.monotonic())
                pending = self.settle(time.monotonic())
                self.draw(size)
                busy = any(p.get("kind") == "working" for p in (self.doc or {}).get("panes", []))
                wait = FRAME if fading else 0.125 if busy else 0.5
                r, _, _ = select.select([self.fd], [], [], min(wait, pending) if pending else wait)
                if r:
                    data = os.read(self.fd, 4096)
                    if not data:
                        break
                    # A motion report cut by the read boundary waits for its rest instead of
                    # turning into keystrokes; a lone ESC with nothing after it is the Escape key.
                    data, tail = split_complete(tail + data)
                elif tail:
                    data, tail = tail, b""
                else:
                    continue
                for ev in decode(data):
                    self.handle(ev)
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
            self.out.write("\x1b]22;\x07\x1b]111\x07\x1b[?8800l\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?25h\x1b[?1049l")
            self.out.flush()


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    path, dump_size = None, None
    while argv:
        a = argv.pop(0)
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a == "--file" and argv:
            path = argv.pop(0)
        elif a == "--dump" and argv:
            try:
                cols, rows = argv.pop(0).lower().split("x")
                dump_size = (int(cols), int(rows))
            except ValueError:
                print("hivegrid-overview: --dump takes COLSxROWS", file=sys.stderr)
                return 2
        else:
            print(f"hivegrid-overview: unknown argument {a!r} (see --help)", file=sys.stderr)
            return 2
    path = path or state_path()
    if dump_size:
        print("\n".join(dump(render(load(path), *dump_size, time.time(), lambda _: None, lambda: None, lambda: None))))
        return 0
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hivegrid-overview: needs a terminal (--dump prints one frame)", file=sys.stderr)
        return 2
    # A closed pane sends SIGHUP; leave through the normal path so the terminal is restored.
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(0))
    Dock(path).run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
