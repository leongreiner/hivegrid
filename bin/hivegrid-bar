#!/usr/bin/env python3
"""Hivegrid sidebar bar: the narrow strip at the left of every tab, with four buttons.

Runs in the bar pane that config/sidebar.lua creates. Buttons: file explorer, git view, overview
dock, settings; each is 3 rows tall (files rows 2-4, git 5-7, overview 8-10, settings the 3 rows
above the last one). A left click announces the button as the user var `sidebar_click`
(files, git, overview or settings, plus a salt so repeated clicks are changes). Buttons whose
view is open are highlighted: the view comes from the state file
$XDG_RUNTIME_DIR/wezterm-sidebar-$WEZTERM_PANE ("<open|closed> <files|git>", written by the
config), the dock from "<state file>.ov". The pointer becomes a hand over the buttons (OSC 22) and
the hovered button fades to a lighter shade (about 150 ms in, 200 ms out). The Hivegrid build tells
the bar when the pointer leaves it (DEC private mode 8800, a motion report at column 0, row 0),
so the hover also ends then; without it the hover ends at the next motion inside the bar.

Icons are drawn with PIL from the Symbols Nerd Font as inline images, large and crisp; without
PIL or the font they are the same glyphs as text, one cell high.

Usage: hivegrid-bar --surface #rrggbb --raised #rrggbb --dim #rrggbb --bright #rrggbb --accent #rrggbb
"""
import argparse
import base64
import io
import os
import select
import signal
import sys
import termios
import time
import tty

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from hivegrid_ui import cell_pixels, decode, iterm_image, mix, sgr_color  # noqa: E402

try:
    from PIL import Image, ImageDraw, ImageFont
except Exception:  # noqa: BLE001 - any import problem means text icons
    Image = None

BUTTONS = ("files", "git", "overview", "settings")
GLYPHS = {"files": "\uf07c", "git": "\ue725", "overview": "\uf0ca", "settings": "\uf013"}
FONT_NAME = "SymbolsNerdFontMono-Regular.ttf"
STEPS = 8  # shades between rest and full hover: at most this many icon images per button
HOVER_BLEND = 0.45  # share of the way from surface to raised that the hovered background reaches
FADE_IN, FADE_OUT = 0.15, 0.20  # seconds from rest to full hover and back
FRAME = 1 / 30  # seconds between frames while a fade runs
IDLE = 0.3  # seconds between looks at the state files while nothing animates
FONT_DIRS = (
    os.environ.get("HIVEGRID_ICON_FONT_DIR", ""),
    os.path.expanduser("~/.local/share/hivegrid"),
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "wezterm", "assets", "fonts"),
)


def find_font():
    for d in FONT_DIRS:
        path = os.path.join(d, FONT_NAME) if d else ""
        if path and os.path.isfile(path):
            return path
    return None


def tops(rows):
    """Top row (0-based) of each button for a bar `rows` tall."""
    return {"files": 1, "git": 4, "overview": 7, "settings": rows - 4}


def button_at(y, rows):
    """The button under row y (0-based), or None."""
    for name, top in tops(rows).items():
        if top <= y < top + 3:
            return name
    return None


def state_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return f"{runtime}/wezterm-sidebar-{os.environ.get('WEZTERM_PANE', '0')}"


def read_state(path):
    """(open view or None, dock open) from the state file and its .ov flag."""
    view = None
    try:
        with open(path, encoding="utf-8") as f:
            parts = f.read().split()
        if len(parts) >= 2 and parts[0] == "open":
            view = parts[1]
    except OSError:
        pass
    return view, os.path.exists(path + ".ov")


class Bar:
    def __init__(self, colors):
        self.c = colors
        self.fd = sys.stdin.fileno()
        self.out = sys.stdout
        self.running = True
        self.hover = None  # button under the pointer; None once it left the bar
        self.level = dict.fromkeys(BUTTONS, 0.0)  # fade state per button, 0 rest .. 1 hovered
        self.clock = None  # time of the last fade step; None while no fade runs
        self.drawn = {}  # button -> (hot, step) as on screen
        self.serial = 0
        self.font_path = find_font() if Image else None
        self.icons = {}

    # drawing ------------------------------------------------------------------
    def icon_png(self, name, step, w, h):
        """The icon in the shade `step` (0 dim .. STEPS bright), cached per name, step and size."""
        key = (name, step, w, h)
        if key not in self.icons:
            size = max(int(min(w, h) * 0.8), 8)
            font = ImageFont.truetype(self.font_path, size)
            img = Image.new("RGBA", (w, h), (0, 0, 0, 0))
            draw = ImageDraw.Draw(img)
            glyph = GLYPHS[name]
            box = draw.textbbox((0, 0), glyph, font=font)
            x = (w - (box[2] - box[0])) // 2 - box[0]
            y = (h - (box[3] - box[1])) // 2 - box[1]
            draw.text((x, y), glyph, font=font, fill=mix(self.c["dim"], self.c["bright"], step / STEPS))
            buf = io.BytesIO()
            img.save(buf, "PNG")
            self.icons[key] = buf.getvalue()
        return self.icons[key]

    def shade(self, name, state):
        """(open, step) of a button: an open view's button keeps its highlight whatever the
        pointer does, the others follow their fade."""
        view, dock = state
        hot = (view == name) or (name == "overview" and dock)
        return hot, (STEPS if hot else round(self.level[name] * STEPS))

    def button(self, name, top, cols, cw, ch, hot, step):
        """Escape sequences that paint one button: three rows and its icon."""
        e = "\x1b"
        if hot:
            bg, fg, mark = self.c["raised"], self.c["bright"], "▎"
        else:
            t = step / STEPS
            bg = mix(self.c["surface"], self.c["raised"], HOVER_BLEND * t)
            fg, mark = mix(self.c["dim"], self.c["bright"], t), " "
        buf = []
        for y in range(3):
            buf.append(
                f"{e}[{top + y + 1};1H{e}[0;{sgr_color(bg, True)};{sgr_color(self.c['accent'], False)}m"
                f"{mark}{' ' * (cols - 1)}"
            )
        if self.font_path and cols > 1:
            png = self.icon_png(name, step, (cols - 1) * cw, 3 * ch)
            # doNotMoveCursor keeps the next row's cursor move independent of the image.
            buf.append(f"{e}[{top + 1};2H" + iterm_image(png, cols - 1, 3).replace(
                "inline=1;", "inline=1;doNotMoveCursor=1;", 1))
        else:
            buf.append(
                f"{e}[{top + 2};{(cols + 1) // 2}H{e}[0;1;{sgr_color(bg, True)};{sgr_color(fg, False)}m{GLYPHS[name]}"
            )
        return "".join(buf)

    def draw(self, rows, cols, state, full):
        """Paints what differs from the screen: every button when `full` (start, resize), else
        the buttons whose highlight or fade shade changed."""
        e = "\x1b"
        if full:
            self.drawn.clear()
        todo = [(n, t, self.shade(n, state)) for n, t in tops(rows).items()]
        todo = [x for x in todo if self.drawn.get(x[0]) != x[2]]
        if not todo:
            return
        cw, ch = cell_pixels(self.out.fileno())
        buf = [f"{e}[0m{e}[{sgr_color(self.c['surface'], True)}m{e}[2J"] if full else []
        for name, top, shade in todo:
            self.drawn[name] = shade
            buf.append(self.button(name, top, cols, cw, ch, *shade))
        buf.append(f"{e}[0m")
        self.out.write("".join(buf))
        self.out.flush()

    def advance(self, now):
        """Moves every fade on by the time since the last step; True while one is still running."""
        dt = 0.0 if self.clock is None else max(now - self.clock, 0.0)
        busy = False
        for name in BUTTONS:
            target = 1.0 if name == self.hover else 0.0
            level = self.level[name]
            if level < target:
                level = min(target, level + dt / FADE_IN)
            elif level > target:
                level = max(target, level - dt / FADE_OUT)
            self.level[name] = level
            busy = busy or level != target
        self.clock = now if busy else None
        return busy

    # events ---------------------------------------------------------------------
    def set_hover(self, name):
        """The button under the pointer changed (None: pointer elsewhere or gone). Starts its
        fade, and asks for a hand pointer over a button, the default elsewhere (OSC 22,
        Hivegrid build)."""
        prior, self.hover = self.hover, name
        if prior == name:
            return
        if self.clock is None:
            self.clock = time.monotonic()
        if bool(prior) != bool(name):
            self.out.write("\x1b]22;" + ("pointer" if name else "") + "\x07")
            self.out.flush()

    def click(self, name):
        self.serial += 1
        value = base64.b64encode(f"{name}:{self.serial}".encode()).decode()
        self.out.write(f"\x1b]1337;SetUserVar=sidebar_click={value}\x07")
        self.out.flush()

    def handle(self, ev, rows):
        if ev[0] != "mouse":
            return
        _, action, button, x, y = ev
        # A report at column 0, row 0 (x, y < 0 here) says the pointer left the bar.
        name = None if x < 0 or y < 0 else button_at(y, rows)
        # Motion without a button is reported like a drag; either way it moves the pointer.
        if action in ("drag", "press", "release"):
            self.set_hover(name)
        if action == "press" and button == "left" and name:
            self.click(name)

    def run(self):
        old = termios.tcgetattr(self.fd)
        resized = {"v": True}
        try:
            tty.setraw(self.fd)
            self.out.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1003h\x1b[?1006h\x1b[?8800h")
            self.out.write("\x1b]1337;SetUserVar=hivegrid_bar=" + base64.b64encode(b"1").decode() + "\x07")
            self.out.flush()
            signal.signal(signal.SIGWINCH, lambda *_: resized.update(v=True))
            path = state_path()
            while self.running:
                try:
                    size = os.get_terminal_size(self.out.fileno())
                    cols, rows = size.columns, size.lines
                except OSError:
                    cols, rows = 5, 24
                state = read_state(path)
                busy = self.advance(time.monotonic())
                self.draw(rows, cols, state, resized["v"])
                resized["v"] = False
                try:
                    ready, _, _ = select.select([self.fd], [], [], FRAME if busy else IDLE)
                except InterruptedError:
                    continue
                if ready:
                    data = os.read(self.fd, 4096)
                    if not data:
                        break
                    for ev in decode(data):
                        self.handle(ev, rows)
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
            self.out.write("\x1b]22;\x07\x1b[?8800l\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?7h\x1b[?25h\x1b[?1049l")
            self.out.flush()
            for p in (state_path(), state_path() + ".ov"):
                try:
                    os.remove(p)
                except OSError:
                    pass


def parse_color(text):
    if len(text) != 7 or text[0] != "#" or any(c not in "0123456789abcdefABCDEF" for c in text[1:]):
        raise argparse.ArgumentTypeError(f"not a #rrggbb colour: {text!r}")
    return text.lower()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    for name, default in (("surface", "#111b30"), ("raised", "#1d3a70"), ("dim", "#7487ad"),
                          ("bright", "#eaf1ff"), ("accent", "#4f9dff")):
        ap.add_argument(f"--{name}", type=parse_color, default=default)
    args = ap.parse_args()
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hivegrid-bar: needs a terminal", file=sys.stderr)
        return 2
    bar = Bar(vars(args))
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(0))
    bar.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
