#!/usr/bin/env python3
"""Hivegrid sidebar bar: the narrow strip at the left of every tab, with four buttons.

Runs in the bar pane that config/sidebar.lua creates. Buttons: file explorer, git view, overview
dock, settings; each is 3 rows tall (files rows 2-4, git 5-7, overview 8-10, settings the 3 rows
above the last one). A left click announces the button as the user var `sidebar_click`
(files, git, overview or settings, plus a salt so repeated clicks are changes). Buttons whose
view is open are highlighted: the view comes from the state file
$XDG_RUNTIME_DIR/wezterm-sidebar-$WEZTERM_PANE ("<open|closed> <files|git>", written by the
config), the dock from "<state file>.ov". The pointer becomes a hand over the buttons (OSC 22) and
the hovered button fades in a rounded chip of a lighter shade (about 150 ms in, 200 ms out); an
open view's button keeps a raised chip and an accent stripe at the window edge. The Hivegrid build
tells the bar when the pointer leaves it (DEC private mode 8800, a motion report at column 0,
row 0), so the hover also ends then; without it the hover ends at the next motion inside the bar.

The bar sets its surface as the pane's default background (OSC 11), so WezTerm paints the window
padding above and below it in that colour, and follows the saved theme (settings.json) without a
restart. The user vars hivegrid_no_focus and hivegrid_no_dim ask the Hivegrid build not to give it
the keyboard on a click and not to dim it as an inactive pane.

Icons are drawn with PIL from the Symbols Nerd Font as inline images, large and crisp; without
PIL or the font they are the same glyphs as text, one cell high.

Usage: hivegrid-bar --surface #rrggbb --raised #rrggbb --dim #rrggbb --bright #rrggbb --accent #rrggbb
"""
import argparse
import base64
import io
import os
import select
import signal
import sys
import termios
import time
import tty

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

# The hover fade (HOVER_BLEND of the way to `raised`, FADE_IN / FADE_OUT seconds, STEPS shades, a
# frame every FRAME seconds) is the shared one of every Hivegrid TUI.
from hivegrid_ui import (  # noqa: E402
    FADE_IN, FADE_OUT, FRAME, HOVER_BLEND, STEPS, cell_pixels, decode, images_enabled, iterm_image,
    mix, sgr_color, split_complete,
)

try:
    from PIL import Image, ImageDraw, ImageFont
except Exception:  # noqa: BLE001 - any import problem means text icons
    Image = None

try:
    from hivegrid_settings_core import ThemeWatch  # noqa: E402
except Exception:  # noqa: BLE001 - without it the bar keeps the colours it was started with
    ThemeWatch = None

BUTTONS = ("files", "git", "overview", "settings")
GLYPHS = {"files": "\uf07c", "git": "\ue725", "overview": "\uf0ca", "settings": "\uf013"}
FONT_NAME = "SymbolsNerdFontMono-Regular.ttf"
SS = 4  # supersampling of the button shapes
IDLE = 0.3  # seconds between looks at the state files while nothing animates
THEME_POLL = 1.0  # seconds between looks at the saved theme
SETTLE = 0.06  # seconds a new pane size must hold before the bar repaints for it
FONT_DIRS = (
    os.environ.get("HIVEGRID_ICON_FONT_DIR", ""),
    os.path.expanduser("~/.local/share/hivegrid"),
    os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "wezterm", "assets", "fonts"),
)


def find_font():
    for d in FONT_DIRS:
        path = os.path.join(d, FONT_NAME) if d else ""
        if path and os.path.isfile(path):
            return path
    return None


def tops(rows):
    """Top row (0-based) of each button for a bar `rows` tall."""
    return {"files": 1, "git": 4, "overview": 7, "settings": rows - 4}


def button_at(y, rows):
    """The button under row y (0-based), or None."""
    for name, top in tops(rows).items():
        if top <= y < top + 3:
            return name
    return None


def state_path():
    runtime = os.environ.get("XDG_RUNTIME_DIR") or "/tmp"
    return f"{runtime}/wezterm-sidebar-{os.environ.get('WEZTERM_PANE', '0')}"


def read_state(path):
    """(open view or None, dock open, gear nudge) from the state file "<open|closed> <view>
    [nudge]" and its .ov flag. The nudge (pixels, from the config) is how much farther the
    window edge is below the last row than above the first: the window padding differs and the
    rows leave a few pixels over at the bottom."""
    view, nudge = None, 0
    try:
        with open(path, encoding="utf-8") as f:
            parts = f.read().split()
        if len(parts) >= 2 and parts[0] == "open":
            view = parts[1]
        if len(parts) >= 3 and parts[2].lstrip("-").isdigit():
            nudge = int(parts[2])
    except OSError:
        pass
    return view, os.path.exists(path + ".ov"), nudge


def drop_stale(path, now, age=5.0):
    """Removes the state file and the dock flag when they are older than this bar (by more than
    `age` seconds): left behind by an earlier WezTerm whose pane had the same id (ids restart at
    0), they would highlight a view or dock that is not open. The config writes them only after
    the bar pane exists, so a fresh one is never older than the bar."""
    for p in (path, path + ".ov"):
        try:
            if os.path.getmtime(p) < now - age:
                os.remove(p)
        except OSError:
            pass


class Bar:
    def __init__(self, colors):
        self.c = colors
        self.fd = sys.stdin.fileno()
        self.out = sys.stdout
        self.running = True
        self.hover = None  # button under the pointer; None once it left the bar
        self.level = dict.fromkeys(BUTTONS, 0.0)  # fade state per button, 0 rest .. 1 hovered
        self.clock = None  # time of the last fade step; None while no fade runs
        self.drawn = {}  # button -> (hot, step) as on screen
        self.serial = 0
        self.font_path = find_font() if Image and images_enabled() else None
        self.icons = {}
        self.theme = ThemeWatch() if ThemeWatch else None
        self.theme_at = 0.0  # time of the last look at the saved theme
        self.geom = None  # (rows, cols, cell width, cell height) as painted
        self.pending = None  # a new geometry waiting to hold for SETTLE
        self.pending_at = 0.0
        self.dirty = True  # repaint everything on the next frame
        self.winch = False  # a SIGWINCH came since the last pass

    def restyle(self, now):
        """Takes the saved theme's colours (a Save in the settings panel) at most once a second;
        True when they changed, so the caller repaints everything."""
        if not self.theme or now - self.theme_at < THEME_POLL:
            return False
        self.theme_at = now
        try:
            palette = self.theme.poll()
        except Exception:  # noqa: BLE001 - a half-written settings file: keep the colours
            return False
        new = {k: palette.get(k, v) for k, v in self.c.items()} if palette else self.c
        if new == self.c:
            return False
        self.c = new
        self.icons.clear()
        self.out.write(f"\x1b]11;{self.c['surface']}\x07")
        return True

    # drawing ------------------------------------------------------------------
    def button_png(self, name, hot, step, cw, ch, cols):
        """The whole button as one image, cols x 3 cells: a rounded chip in the hover or open
        shade, the accent stripe at the left edge when open, the icon centred. The chip keeps
        the same margin to the window edge and to the divider, which sits half a cell right
        of the bar's last column. Cached per name, shade and size."""
        key = (name, hot, step, cw, ch, cols)
        if key not in self.icons:
            w, h = cols * cw, 3 * ch
            half = cw // 2
            t = step / STEPS
            inset = max(ch // 8, 2)
            # The shapes are drawn at SS times the size and scaled down: PIL does not smooth
            # the corners of a rounded rectangle.
            shapes = Image.new("RGBA", (w * SS, h * SS), (0, 0, 0, 0))
            sd = ImageDraw.Draw(shapes)
            if hot or step:
                bg = self.c["raised"] if hot else mix(self.c["surface"], self.c["raised"], HOVER_BLEND * t)
                sd.rounded_rectangle((half * SS, inset * SS, w * SS - 1, (h - inset) * SS - 1),
                                     radius=max(cw * 3 // 4, 3) * SS, fill=bg)
            if hot:
                sd.rounded_rectangle((-SS * 2, inset * SS, max(cw * 3 // 8, 2) * SS - 1, (h - inset) * SS - 1),
                                     radius=SS * 2, fill=self.c["accent"])
            img = shapes.resize((w, h), Image.BOX)  # an exact average: no ringing at the edges
            draw = ImageDraw.Draw(img)
            font = ImageFont.truetype(self.font_path, max(int(min(w - half, h) * 0.7), 8))
            glyph = GLYPHS[name]
            box = draw.textbbox((0, 0), glyph, font=font)
            x = (w + half - (box[2] - box[0])) // 2 - box[0]
            y = (h - (box[3] - box[1])) // 2 - box[1]
            draw.text((x, y), glyph, font=font, fill=self.c["bright"] if hot else mix(self.c["dim"], self.c["bright"], t))
            buf = io.BytesIO()
            img.save(buf, "PNG")
            self.icons[key] = buf.getvalue()
        return self.icons[key]

    def gear_png(self, hot, step, cw, ch, cols, nudge):
        """The settings button moved `nudge` pixels down (up when negative, at most a row), on
        an image 5 rows tall from the row above it to the bottom row, so that the space below
        it matches the space above the first button."""
        key = ("gear", hot, step, cw, ch, cols, nudge)
        if key not in self.icons:
            img = Image.new("RGBA", (cols * cw, 5 * ch), (0, 0, 0, 0))
            img.paste(Image.open(io.BytesIO(self.button_png("settings", hot, step, cw, ch, cols))), (0, ch + nudge))
            buf = io.BytesIO()
            img.save(buf, "PNG")
            self.icons[key] = buf.getvalue()
        return self.icons[key]

    def shade(self, name, state):
        """(open, step) of a button: an open view's button keeps its highlight whatever the
        pointer does, the others follow their fade."""
        view, dock = state[:2]
        hot = (view == name) or (name == "overview" and dock)
        return hot, (STEPS if hot else round(self.level[name] * STEPS))

    def button(self, name, top, cols, cw, ch, hot, step, nudge=0):
        """Escape sequences that paint one button: three rows and its icon. The settings button
        spans 5 rows when the row above it is free, its chip `nudge` pixels lower (gear_png)."""
        e = "\x1b"
        if self.font_path and cols > 1:
            tall = name == "settings" and top > tops(0)["overview"] + 4
            first, n = (top - 1, 5) if tall else (top, 3)
            buf = [f"{e}[{first + y + 1};1H{e}[0;{sgr_color(self.c['surface'], True)}m{' ' * cols}" for y in range(n)]
            if tall:
                png = self.gear_png(hot, step, cw, ch, cols, max(-ch, min(ch, nudge)))
            else:
                png = self.button_png(name, hot, step, cw, ch, cols)
            # doNotMoveCursor keeps the next row's cursor move independent of the image.
            buf.append(f"{e}[{first + 1};1H" + iterm_image(png, cols, n).replace(
                "inline=1;", "inline=1;doNotMoveCursor=1;", 1))
            return "".join(buf)
        # Text fallback: the cells carry the shade, the open button a left stripe.
        if hot:
            bg, fg, mark = self.c["raised"], self.c["bright"], "▎"
        else:
            t = step / STEPS
            bg = mix(self.c["surface"], self.c["raised"], HOVER_BLEND * t)
            fg, mark = mix(self.c["dim"], self.c["bright"], t), " "
        buf = [
            f"{e}[{top + y + 1};1H{e}[0;{sgr_color(bg, True)};{sgr_color(self.c['accent'], False)}m{mark}{' ' * (cols - 1)}"
            for y in range(3)
        ]
        buf.append(
            f"{e}[{top + 2};{(cols + 1) // 2}H{e}[0;1;{sgr_color(bg, True)};{sgr_color(fg, False)}m{GLYPHS[name]}"
        )
        return "".join(buf)

    def draw(self, rows, cols, state, full, cell=None):
        """Paints what differs from the screen: every button when `full` (start, resize), else
        the buttons whose highlight or fade shade changed."""
        e = "\x1b"
        if full:
            self.drawn.clear()
        nudge = state[2] if len(state) > 2 else 0
        todo = [(n, t, self.shade(n, state) + ((nudge,) if n == "settings" else ())) for n, t in tops(rows).items()]
        todo = [x for x in todo if self.drawn.get(x[0]) != x[2]]
        if not todo:
            return
        cw, ch = cell or cell_pixels(self.out.fileno())
        buf = [f"{e}[0m{e}[{sgr_color(self.c['surface'], True)}m{e}[2J"] if full else []
        for name, top, shade in todo:
            self.drawn[name] = shade
            buf.append(self.button(name, top, cols, cw, ch, *shade))
        buf.append(f"{e}[0m")
        self.out.write("".join(buf))
        self.out.flush()

    def advance(self, now):
        """Moves every fade on by the time since the last step; True while one is still running."""
        dt = 0.0 if self.clock is None else max(now - self.clock, 0.0)
        busy = False
        for name in BUTTONS:
            target = 1.0 if name == self.hover else 0.0
            level = self.level[name]
            if level < target:
                level = min(target, level + dt / FADE_IN)
            elif level > target:
                level = max(target, level - dt / FADE_OUT)
            self.level[name] = level
            busy = busy or level != target
        self.clock = now if busy else None
        return busy

    # events ---------------------------------------------------------------------
    def set_hover(self, name):
        """The button under the pointer changed (None: pointer elsewhere or gone). Starts its
        fade, and asks for a hand pointer over a button, the default elsewhere (OSC 22,
        Hivegrid build)."""
        prior, self.hover = self.hover, name
        if prior == name:
            return
        if self.clock is None:
            self.clock = time.monotonic()
        if bool(prior) != bool(name):
            self.out.write("\x1b]22;" + ("pointer" if name else "") + "\x07")
            self.out.flush()

    def click(self, name):
        self.serial += 1
        value = base64.b64encode(f"{name}:{self.serial}".encode()).decode()
        self.out.write(f"\x1b]1337;SetUserVar=sidebar_click={value}\x07")
        self.out.flush()

    def handle(self, ev, rows):
        if ev[0] != "mouse":
            return
        _, action, button, x, y = ev
        # A report at column 0, row 0 (x, y < 0 here) says the pointer left the bar.
        name = None if x < 0 or y < 0 else button_at(y, rows)
        # Motion without a button is reported like a drag; either way it moves the pointer.
        if action in ("drag", "press", "release"):
            self.set_hover(name)
        if action == "press" and button == "left" and name:
            self.click(name)

    def measure(self):
        """(rows, cols, cell width, cell height) of the pane now."""
        try:
            size = os.get_terminal_size(self.out.fileno())
            cols, rows = size.columns, size.lines
        except OSError:
            cols, rows = 5, 24
        return (rows, cols, *cell_pixels(self.out.fileno()))

    def wait_for(self, geom, now, resized=False):
        """Seconds to wait before painting the pane at `geom` (0: paint now). After a resize
        (`resized`: a SIGWINCH came, or the measured geometry differs) the whole bar is painted
        once the size held for SETTLE seconds: a pane resized twice in a row (the sidebar widens
        the bar to split the view off it, then it is 5 columns again) is painted once, at its
        final size, and is painted even when that size is the old one, because WezTerm rewraps
        the screen on each resize and loses the images. The first geometry is painted at once."""
        if resized or geom != (self.pending or self.geom):
            self.pending, self.pending_at = geom, now
        if self.pending is None:
            return 0.0
        left = SETTLE - (now - self.pending_at)
        if self.geom is not None and left > 0:
            return left
        self.geom, self.pending = geom, None
        self.dirty = True
        return 0.0

    def run(self):
        old = termios.tcgetattr(self.fd)
        try:
            tty.setraw(self.fd)
            self.out.write("\x1b[?1049h\x1b[?25l\x1b[?7l\x1b[?1000h\x1b[?1003h\x1b[?1006h\x1b[?8800h")
            # The surface as the pane's default background (OSC 11): WezTerm fills the window
            # padding above and below an edge pane and the leftover pixels beside its last
            # column with that colour, so the bar runs from the header to the bottom border.
            self.out.write(f"\x1b]11;{self.c['surface']}\x07")
            one = base64.b64encode(b"1").decode()
            # hivegrid_bar marks the pane for the config and the fork. On the Hivegrid build,
            # hivegrid_no_focus keeps a click here from taking the keyboard from the grid,
            # hivegrid_no_dim keeps inactive_pane_hsb off, so the bar shows the theme's colours,
            # and hivegrid_fixed_width keeps its columns when the tab is resized.
            self.out.write("".join(f"\x1b]1337;SetUserVar={var}={one}\x07" for var in (
                "hivegrid_bar", "hivegrid_no_focus", "hivegrid_no_dim", "hivegrid_fixed_width")))
            self.out.flush()
            # SIGWINCH is only noted (a flag read on the next pass) and interrupts the wait;
            # the pass also compares the geometry (rows, columns, cell pixels) with the painted
            # one, so a resize is never missed, not even one that lands while a frame is drawn.
            signal.signal(signal.SIGWINCH, lambda *_: setattr(self, "winch", True))
            path = state_path()
            drop_stale(path, time.time())
            pending = b""  # an escape sequence the last read cut off
            while self.running:
                now = time.monotonic()
                if self.restyle(now):
                    self.dirty = True
                resized, self.winch = self.winch, False
                rows, cols, cw, ch = geom = self.measure()
                wait = self.wait_for(geom, now, resized)
                busy = self.advance(now)
                if not wait:
                    self.draw(rows, cols, read_state(path), self.dirty, (cw, ch))
                    self.dirty = False
                try:
                    ready, _, _ = select.select([self.fd], [], [], wait or (FRAME if busy else IDLE))
                except InterruptedError:
                    continue
                if ready:
                    data = os.read(self.fd, 4096)
                    if not data:
                        break
                    head, pending = split_complete(pending + data)
                    for ev in decode(head):
                        self.handle(ev, rows)
        finally:
            termios.tcsetattr(self.fd, termios.TCSADRAIN, old)
            self.out.write("\x1b]22;\x07\x1b]111\x07\x1b[?8800l\x1b[?1006l\x1b[?1003l\x1b[?1000l\x1b[?7h\x1b[?25h\x1b[?1049l")
            self.out.flush()
            for p in (state_path(), state_path() + ".ov"):
                try:
                    os.remove(p)
                except OSError:
                    pass


def parse_color(text):
    if len(text) != 7 or text[0] != "#" or any(c not in "0123456789abcdefABCDEF" for c in text[1:]):
        raise argparse.ArgumentTypeError(f"not a #rrggbb colour: {text!r}")
    return text.lower()


def main():
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    for name, default in (("surface", "#111b30"), ("raised", "#1d3a70"), ("dim", "#7487ad"),
                          ("bright", "#eaf1ff"), ("accent", "#4f9dff")):
        ap.add_argument(f"--{name}", type=parse_color, default=default)
    args = ap.parse_args()
    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hivegrid-bar: needs a terminal", file=sys.stderr)
        return 2
    bar = Bar(vars(args))
    for sig in (signal.SIGHUP, signal.SIGTERM):
        signal.signal(sig, lambda *_: sys.exit(0))
    bar.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
