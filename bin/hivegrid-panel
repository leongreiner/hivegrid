#!/usr/bin/env python3
"""Hivegrid panels: settings, usage history, agent overview and system monitor in one terminal UI.

Usage: hivegrid-panel [settings|usage|agents|monitor|hive] [options]

Runs in a terminal (WezTerm overlay or tab); the mouse works, so do the keys: Tab or F1-F4 and
a click on the tabs switch panels (F5 is the hive, where Tab selects agents), q or Esc closes. The
settings panel reads and writes ~/.config/hivegrid/settings.json (env HIVEGRID_SETTINGS), which the
WezTerm config watches.

Options:
  --account LABEL   usage: account to show first
  --range R         usage: 6h, 24h, 7d or 30d
  --settings PATH   use another settings file
  --history PATH    usage: use another history.jsonl
  --print           settings: print the effective settings as JSON and exit (no writes)
  --dump COLSxROWS  print one frame of the chosen panel as plain text and exit (no terminal needed)
  -h, --help        show this help
Environment: HIVEGRID_NO_IMAGES=1 draws charts in braille instead of inline images.
"""
import json
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from hivegrid_settings_core import Model, Settings, settings_path  # noqa: E402

PANELS = ["settings", "usage", "agents", "monitor", "hive"]


def main(argv=None):
    argv = list(sys.argv[1:] if argv is None else argv)
    panel, path, account, rng, history, do_print, dump = "settings", None, None, "24h", None, False, None
    while argv:
        a = argv.pop(0)
        if a in ("-h", "--help"):
            print(__doc__.strip())
            return 0
        if a in PANELS:
            panel = a
        elif a == "--print":
            do_print = True
        elif a == "--dump" and argv:
            try:
                cols, rows = argv.pop(0).lower().split("x")
                dump = (int(cols), int(rows))
            except ValueError:
                print("hivegrid-panel: --dump takes COLSxROWS", file=sys.stderr)
                return 2
        elif a in ("--settings", "--account", "--range", "--history", "--origin") and argv:
            value = argv.pop(0)
            if a == "--settings":
                path = value
            elif a == "--account":
                account = value
            elif a == "--range":
                rng = value
            elif a == "--origin":
                os.environ["HIVEGRID_ORIGIN_PANE"] = value  # the pane the overlay covers (hive)
            else:
                history = value
        else:
            print(f"hivegrid-panel: unknown argument {a!r} (see --help)", file=sys.stderr)
            return 2
    settings = Settings(settings_path(path))
    if do_print:
        json.dump(settings.effective(), sys.stdout, indent=2)
        sys.stdout.write("\n")
        return 0
    if not dump and not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("hivegrid-panel: needs a terminal (--print gives the settings as JSON)", file=sys.stderr)
        return 2
    import hivegrid_hive as HV
    import hivegrid_panels as P
    import hivegrid_ui as U

    model = Model(settings)
    pages = [P.SettingsPage(model), P.UsagePage(model, account=account, range_name=rng, history=history),
             P.AgentsPage(model), P.MonitorPage(model), HV.HivePage(model)]
    ui = U.UI(model, pages, active=PANELS.index(panel))
    if dump:
        import io
        ui.size, ui.out = dump, io.StringIO()
        ui.page().on_show(ui)
        ui.draw()
        print("\n".join("".join(c[0] for c in row).rstrip() for row in ui.cv.cells))
        return 0
    ui.tickers.append(pages[3].sampler.tick)
    if settings.error:
        ui.say(settings.error, True)
    ui.run()
    return 0


if __name__ == "__main__":
    sys.exit(main())
